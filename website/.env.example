# Server-only Nest API origin used by Route Handlers. Never expose this as NEXT_PUBLIC_*.
# Prefer DEALGO_API_BASE_URL; API_BASE_URL is accepted as a fallback alias.
DEALGO_API_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:3001

# Optional public API origin for direct browser calls. The browser currently only talks
# to same-origin Route Handlers; when set, this origin (and its ws/wss form) is added to
# the CSP connect-src at build time. Never put tokens or credentials in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Optional Mapbox public token (pk.…) for Admin map tiles only. Leave empty to use
# OpenStreetMap/Carto tiles (attribution shown). No token is bundled in code.
# Road routes come from Nest (backend ROUTING_PROVIDER, DEC-PROD-045); none → straight line.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional Sentry (DEC-PROD-054). Empty = disabled; the SDK is never loaded.
# NEXT_PUBLIC_* values are baked in at build time (Docker build args).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Server-side override (defaults to NEXT_PUBLIC_SENTRY_DSN).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

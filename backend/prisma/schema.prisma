  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketCategory {
  RIDE
  FOOD
  PAYMENT
  ACCOUNT
  SAFETY
  OTHER
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketChannel {
  APP
  WEB
}

enum SupportTicketRelatedType {
  RIDE
  FOOD_ORDER
}

enum SupportMessageAuthor {
  REQUESTER
  STAFF
}

// Help-center tickets (S021–S023, public /support form). App tickets belong to a user;
// website tickets carry only the contact the visitor typed (staff call/email back).
// The description is the first REQUESTER message.
model SupportTicket {
  id              String                    @id @default(uuid()) @db.Uuid
  code            String                    @unique @db.VarChar(20)
  channel         SupportTicketChannel
  requesterUserId String?                   @db.Uuid
  requester       User?                     @relation("SupportTicketRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)
  requesterRole   String                    @db.VarChar(16)
  contactName     String?                   @db.VarChar(80)
  contact         String?                   @db.VarChar(120)
  category        SupportTicketCategory
  relatedType     SupportTicketRelatedType?
  relatedId       String?                   @db.Uuid
  externalRef     String?                   @db.VarChar(50)
  subject         String                    @db.VarChar(120)
  status          SupportTicketStatus       @default(OPEN)
  priority        SupportTicketPriority     @default(NORMAL)
  lastMessageAt   DateTime                  @default(now())
  lastAuthor      SupportMessageAuthor      @default(REQUESTER)
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  messages        SupportTicketMessage[]

  @@index([requesterUserId, createdAt])
  @@index([status, lastMessageAt])
  @@index([contact, createdAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id           String               @id @default(uuid()) @db.Uuid
  ticketId     String               @db.Uuid
  ticket       SupportTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType   SupportMessageAuthor
  authorUserId String?              @db.Uuid
  body         String
  /// Stored upload refs (DEC-PROD-020): [{key,label,contentType,sizeBytes,uploadedAt}].
  attachments  Json                 @default("[]")
  createdAt    DateTime             @default(now())

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

/// DEC-PROD-021: read-only trip link a customer sends to family. Only the SHA-256 of the
/// token is stored; the raw token is returned once. Expires at expiresAt or shortly after the trip ends.
model RideShareLink {
  id              String   @id @default(uuid()) @db.Uuid
  rideId          String   @db.Uuid
  ride            Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  tokenHash       String   @unique @db.VarChar(64)
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([rideId, expiresAt])
  @@map("ride_share_links")
}

enum AccountDeletionMethod {
  PHONE_OTP
  PASSWORD
}

enum AccountDeletionStatus {
  /// Waiting for re-authentication (OTP / password).
  PENDING
  /// Confirmed: account soft-deleted, purge after the grace period.
  SCHEDULED
  CANCELLED
  PURGED
}

/// S027 account deletion (DEC-PROD-037). One row per attempt; the latest row is the user's status.
model AccountDeletionRequest {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @db.Uuid
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  method            AccountDeletionMethod
  status            AccountDeletionStatus @default(PENDING)
  codeHash          String?
  attemptCount      Int                   @default(0)
  expiresAt         DateTime
  confirmedAt       DateTime?
  purgeAfter        DateTime?
  cancelledAt       DateTime?
  cancelledByUserId String?               @db.Uuid
  purgedAt          DateTime?
  createdAt         DateTime              @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, purgeAfter])
  @@map("account_deletion_requests")
}

/// Ops confirms the driver paid the accrued platform fees (cash) up to settledThrough.
model DriverFeeSettlement {
  id             String   @id @default(uuid()) @db.Uuid
  driverId       String   @db.Uuid
  driver         User     @relation("DriverFeeSettlementDriver", fields: [driverId], references: [id], onDelete: Restrict)
  amountVnd      Int
  settledThrough DateTime
  actorUserId    String   @db.Uuid
  actor          User     @relation("DriverFeeSettlementActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  reason         String   @db.VarChar(500)
  createdAt      DateTime @default(now())

  @@index([driverId, settledThrough(sort: Desc)])
  @@map("driver_fee_settlements")
}

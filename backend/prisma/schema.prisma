enum SupportMessageAuthor {
  REQUESTER
  STAFF
}

// Help-center tickets (S021–S023, public /support form). App tickets belong to a user;
// website tickets carry only the contact the visitor typed (staff call/email back).
// The description is the first REQUESTER message.
model SupportTicket {
  id              String                    @id @default(uuid()) @db.Uuid
  code            String                    @unique @db.VarChar(20)
  channel         SupportTicketChannel
  requesterUserId String?                   @db.Uuid
  requester       User?                     @relation("SupportTicketRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)
  requesterRole   String                    @db.VarChar(16)
  contactName     String?                   @db.VarChar(80)
  contact         String?                   @db.VarChar(120)
  category        SupportTicketCategory
  relatedType     SupportTicketRelatedType?
  relatedId       String?                   @db.Uuid
  externalRef     String?                   @db.VarChar(50)
  subject         String                    @db.VarChar(120)
  status          SupportTicketStatus       @default(OPEN)
  priority        SupportTicketPriority     @default(NORMAL)
  lastMessageAt   DateTime                  @default(now())
  lastAuthor      SupportMessageAuthor      @default(REQUESTER)
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  messages        SupportTicketMessage[]

  @@index([requesterUserId, createdAt])
  @@index([status, lastMessageAt])
  @@index([contact, createdAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id           String               @id @default(uuid()) @db.Uuid
  ticketId     String               @db.Uuid
  ticket       SupportTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType   SupportMessageAuthor
  authorUserId String?              @db.Uuid
  body         String
  /// Stored upload refs (DEC-PROD-020): [{key,label,contentType,sizeBytes,uploadedAt}].
  attachments  Json                 @default("[]")
  createdAt    DateTime             @default(now())

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

/// DEC-PROD-021: read-only trip link a customer sends to family. Only the SHA-256 of the
/// token is stored; the raw token is returned once. Expires at expiresAt or shortly after the trip ends.
model RideShareLink {
  id              String   @id @default(uuid()) @db.Uuid
  rideId          String   @db.Uuid
  ride            Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  tokenHash       String   @unique @db.VarChar(64)
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([rideId, expiresAt])
  @@map("ride_share_links")
}

enum AccountDeletionMethod {
  PHONE_OTP
  PASSWORD
  /// WebAuthn assertion with one of the user's own passkeys (codeHash = hash of the challenge).
  PASSKEY
}

enum AccountDeletionStatus {
  /// Waiting for re-authentication (OTP / password / passkey).
  PENDING
  /// Confirmed: account soft-deleted, purge after the grace period.
  SCHEDULED
  CANCELLED
  PURGED
}

/// S027 account deletion (DEC-PROD-037). One row per attempt; the latest row is the user's status.
model AccountDeletionRequest {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @db.Uuid
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  method            AccountDeletionMethod
  status            AccountDeletionStatus @default(PENDING)
  codeHash          String?
  attemptCount      Int                   @default(0)
  expiresAt         DateTime
  confirmedAt       DateTime?
  purgeAfter        DateTime?
  cancelledAt       DateTime?
  cancelledByUserId String?               @db.Uuid
  purgedAt          DateTime?
  createdAt         DateTime              @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, purgeAfter])
  @@map("account_deletion_requests")
}

/// Ops confirms the driver's accrued platform fees up to settledThrough.
/// amountVnd is the cash Ops collected; creditAppliedVnd was paid from the driver's prepayment.
model DriverFeeSettlement {
  id               String   @id @default(uuid()) @db.Uuid
  driverId         String   @db.Uuid
  driver           User     @relation("DriverFeeSettlementDriver", fields: [driverId], references: [id], onDelete: Restrict)
  amountVnd        Int
  creditAppliedVnd Int      @default(0)
  settledThrough   DateTime
  actorUserId      String   @db.Uuid
  actor            User     @relation("DriverFeeSettlementActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  reason           String   @db.VarChar(500)
  createdAt        DateTime @default(now())

  @@index([driverId, settledThrough(sort: Desc)])
  @@map("driver_fee_settlements")
}

enum PublicPageStatus {
  DRAFT
  PUBLISHED
}

// Admin-editable public pages (privacy, terms, support, …) per locale (DEC-PROD-056).
// The working copy lives here; every publish snapshots a numbered PublicPageRevision.
model PublicPage {
  id              String               @id @default(uuid()) @db.Uuid
  slug            String               @db.VarChar(60)
  locale          String               @db.VarChar(5)
  title           String               @db.VarChar(200)
  summary         String?              @db.VarChar(500)
  /// JSON content validated per slug (legal sections or support config; DEC-PROD-055).
  body            String               @db.Text
  status          PublicPageStatus     @default(DRAFT)
  /// Latest published version; 0 = never published.
  version         Int                  @default(0)
  effectiveAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  updatedByUserId String?              @db.Uuid
  revisions       PublicPageRevision[]

  @@unique([slug, locale])
  @@map("public_pages")
}

model PublicPageRevision {
  id                String     @id @default(uuid()) @db.Uuid
  pageId            String     @db.Uuid
  page              PublicPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version           Int
  title             String     @db.VarChar(200)
  summary           String?    @db.VarChar(500)
  body              String     @db.Text
  effectiveAt       DateTime?
  publishedAt       DateTime   @default(now())
  publishedByUserId String?    @db.Uuid

  @@unique([pageId, version])
  @@map("public_page_revisions")
}

// Worker liveness for /health/ready (DEC-PROD-054). One row per worker process role.
model WorkerHeartbeat {
  name      String   @id @db.VarChar(60)
  instance  String   @db.VarChar(120)
  startedAt DateTime
  beatAt    DateTime
  meta      Json     @default("{}")

  @@map("worker_heartbeats")
}

/// A driver gave up an assigned job (ride returned to bidding / food order released).
/// Counted in the driver's completion rate. actor=DRIVER (self) or SYSTEM (timeout).
model DriverJobCancellation {
  id         String           @id @default(uuid()) @db.Uuid
  entityType LedgerEntityType
  entityId   String           @db.Uuid
  driverId   String           @db.Uuid
  actor      CancelActor
  reasonCode String           @db.VarChar(40)
  fromStatus String           @db.VarChar(32)
  createdAt  DateTime         @default(now())

  @@index([driverId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("driver_job_cancellations")
}

enum CustomerFeeKind {
  LATE_CANCEL
  NO_SHOW
  /// DEC-PROD-071: parcel handed back to the sender after a failed delivery.
  PARCEL_RETURN
}

enum CustomerFeeStatus {
  PENDING
  COLLECTED
  WAIVED
}

/// Fee owed by a customer for a late cancel / no-show. Cash-only app,
/// so it is added to the customer's next completed ride and passed to the affected driver.
model CustomerFeeCharge {
  id                  String            @id @default(uuid()) @db.Uuid
  customerId          String            @db.Uuid
  rideId              String            @db.Uuid
  kind                CustomerFeeKind
  amountVnd           Int
  beneficiaryDriverId String?           @db.Uuid
  status              CustomerFeeStatus @default(PENDING)
  collectedRideId     String?           @db.Uuid
  createdAt           DateTime          @default(now())
  collectedAt         DateTime?

  @@unique([rideId, kind])
  @@index([customerId, status])
  @@map("customer_fee_charges")
}

/// Signed driver<->platform balance movements besides platform fees.
/// amountVnd > 0: the driver owes DealGo; < 0: DealGo owes the driver (credit).
/// Summed with job_earnings.feeVnd after the last DriverFeeSettlement.
model DriverBalanceAdjustment {
  id         String   @id @default(uuid()) @db.Uuid
  driverId   String   @db.Uuid
  amountVnd  Int
  kind       String   @db.VarChar(40)
  refType    String   @db.VarChar(20)
  refId      String   @db.Uuid
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@unique([kind, refType, refId, driverId])
  @@index([driverId, occurredAt])
  @@map("driver_balance_adjustments")
}

/// A prepayment the driver made to cover future platform fees. Not an e-wallet: no withdrawal,
/// no transfer, no interest; unused credit is refunded only by Ops to the verified source account.
enum DriverTopUpStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  FAILED
}

model DriverTopUp {
  id              String                    @id @default(uuid()) @db.Uuid
  driverId        String                    @db.Uuid
  driver          User                      @relation("DriverTopUpDriver", fields: [driverId], references: [id], onDelete: Restrict)
  /// Numeric order code sent to the PSP. Reserved range 1_000_000_000..2_147_483_647.
  orderCode       Int                       @unique @default(autoincrement())
  provider        String                    @default("payos") @db.VarChar(32)
  /// Provider-side reference used by callbacks (payOS order code string, VNPAY vnp_TxnRef).
  providerRef     String?                   @db.VarChar(120)
  paymentLinkId   String?                   @db.VarChar(120)
  amountVnd       Int
  /// Money still usable to offset fees (amount - consumed - refunded).
  remainingVnd    Int                       @default(0)
  consumedVnd     Int                       @default(0)
  refundedVnd     Int                       @default(0)
  status          DriverTopUpStatus         @default(PENDING)
  checkoutUrl     String?                   @db.VarChar(2000)
  qrCode          String?                   @db.VarChar(2000)
  providerTransId String?                   @db.VarChar(120)
  idempotencyKey  String?                   @db.VarChar(120)
  failureReason   String?                   @db.VarChar(255)
  expiresAt       DateTime?
  paidAt          DateTime?
  refundedAt      DateTime?
  refundBankRef   String?                   @db.VarChar(120)
  refundReason    String?                   @db.VarChar(500)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  applications    DriverCreditApplication[]

  @@unique([driverId, idempotencyKey])
  @@unique([provider, providerRef])
  @@index([driverId, status])
  @@index([status, updatedAt])
  @@map("driver_top_ups")
}

/// Which prepayment paid which fee: FIFO allocation when Ops settles the driver's balance.
model DriverCreditApplication {
  id         String      @id @default(uuid()) @db.Uuid
  topUpId    String      @db.Uuid
  topUp      DriverTopUp @relation(fields: [topUpId], references: [id], onDelete: Restrict)
  driverId   String      @db.Uuid
  amountVnd  Int
  refType    String      @db.VarChar(32)
  refId      String      @db.Uuid
  occurredAt DateTime
  createdAt  DateTime    @default(now())

  @@unique([refType, refId, topUpId])
  @@index([driverId, occurredAt])
  @@map("driver_credit_applications")
}

/// The driver rates the customer after a completed ride (one per ride).
model CustomerRating {
  id         String   @id @default(uuid()) @db.Uuid
  rideId     String   @unique @db.Uuid
  customerId String   @db.Uuid
  driverId   String   @db.Uuid
  stars      Int      @db.SmallInt
  tags       String[] @db.VarChar(40)
  comment    String?  @db.VarChar(300)
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@map("customer_ratings")
}

enum FoodOrderChangeStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

/// Merchant edits an order (item out of stock / quantity); the customer confirms or the order is cancelled.
model FoodOrderChange {
  id             String                @id @default(uuid()) @db.Uuid
  orderId        String                @db.Uuid
  order          FoodOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status         FoodOrderChangeStatus @default(PENDING)
  reasonCode     String                @db.VarChar(32)
  note           String?               @db.VarChar(200)
  /// [{lineId, name, fromQuantity, toQuantity}] — toQuantity 0 removes the line.
  lines          Json
  oldSubtotalVnd Int
  newSubtotalVnd Int
  newDiscountVnd Int
  newTotalVnd    Int
  expiresAt      DateTime
  respondedAt    DateTime?
  createdAt      DateTime              @default(now())

  @@index([orderId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("food_order_changes")
}

enum FoodDeliveryOfferStatus {
  PENDING
  SELECTED
  LOST
  /// The driver withdrew a pending counter (may counter again while the order is open).
  WITHDRAWN
}

/// Driver counter-offer on a food order's delivery fee (customer selects one).
model FoodDeliveryOffer {
  id        String                  @id @default(uuid()) @db.Uuid
  orderId   String                  @db.Uuid
  order     FoodOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId  String                  @db.Uuid
  driver    User                    @relation(fields: [driverId], references: [id], onDelete: Restrict)
  amountVnd Int
  status    FoodDeliveryOfferStatus @default(PENDING)
  expiresAt DateTime
  editCount Int                     @default(0)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([orderId, driverId])
  @@index([orderId, status])
  @@index([driverId, status])
  @@map("food_delivery_offers")
}

/// Merchant payout statement per store and ICT period (Ops records the payment).
model MerchantSettlement {
  id                String   @id @default(uuid()) @db.Uuid
  storeId           String   @db.Uuid
  periodStart       DateTime @db.Date
  periodEnd         DateTime @db.Date
  orderCount        Int
  grossVnd          Int
  merchantFundedVnd Int
  commissionVnd     Int
  netVnd            Int
  actorUserId       String   @db.Uuid
  note              String?  @db.VarChar(500)
  createdAt         DateTime @default(now())

  @@unique([storeId, periodStart, periodEnd])
  @@index([storeId, periodEnd(sort: Desc)])
  @@map("merchant_settlements")
}

/// t82u (DEC-PROD-090): a published legal document version users must accept (Grab/Be style).
/// Points at an already-published PublicPage version — the legal text itself lives in public_pages.
model LegalPolicyVersion {
  id                String             @id @default(uuid()) @db.Uuid
  /// PublicPage slug: terms | privacy.
  slug              String             @db.VarChar(60)
  /// PublicPage.version (vi) at publish time.
  version           Int
  title             String             @db.VarChar(200)
  changelog         String             @db.VarChar(2000)
  effectiveAt       DateTime?
  /// Role names (CUSTOMER, DRIVER, MERCHANT) who must accept / get the email.
  audienceRoles     String[]
  requiresConsent   Boolean            @default(true)
  publishedAt       DateTime           @default(now())
  publishedByUserId String?            @db.Uuid
  /// NONE | QUEUED | SENDING | SENT
  emailStatus       String             @default("NONE") @db.VarChar(16)
  emailQueuedAt     DateTime?
  emailRecipients   Int?
  emailSentCount    Int                @default(0)
  emailFailedCount  Int                @default(0)
  createdAt         DateTime           @default(now())
  consents          UserLegalConsent[]

  @@unique([slug, version])
  @@index([publishedAt])
  @@map("legal_policy_versions")
}

/// t82u: audit row for one user accepting one LegalPolicyVersion.
model UserLegalConsent {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @db.Uuid
  policyVersionId String             @db.Uuid
  policyVersion   LegalPolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  slug            String             @db.VarChar(60)
  version         Int
  acceptedAt      DateTime           @default(now())
  ip              String?            @db.VarChar(64)
  userAgent       String?            @db.VarChar(300)

  @@unique([userId, policyVersionId])
  @@index([userId])
  @@map("user_legal_consents")
}

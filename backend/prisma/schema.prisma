  @@map("service_regions")
}

enum PlatformSettingValueType {
  string
  number
  json
}

// Admin-editable OPEN tunables (TEST_ONLY / PROPOSED). Secrets stay in env.
model PlatformSetting {
  id              String                   @id @default(uuid()) @db.Uuid
  key             String                   @unique @db.VarChar(80)
  value           String                   @db.Text
  valueType       PlatformSettingValueType

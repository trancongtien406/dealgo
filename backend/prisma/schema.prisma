generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  MERCHANT
  DRIVER
  OPS
}

enum RoleGrantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum SessionChannel {
  CUSTOMER
  OPS
}

enum SessionRevokeReason {
  USER
  REUSE
}

enum PasskeyCeremonyKind {
  REGISTRATION
  AUTHENTICATION
}

// Profile gender. API: MALE | FEMALE | OTHER (UI labels Nam | Nữ | Khác).
enum UserGender {
  MALE
  FEMALE
  OTHER
}

model User {
  id                          String                      @id @default(uuid()) @db.Uuid
  email                       String?                     @unique
  phone                       String?                     @unique
  displayName                 String
  dateOfBirth                 DateTime?
  gender                      UserGender?
  avatarUrl                   String?
  phoneVerifiedAt             DateTime?
  /// Contact number typed at profile completion (not OTP-verified, not a sign-in identifier).
  contactPhone                String?                     @db.VarChar(16)
  emailVerifiedAt             DateTime?
  /// S027 (DEC-PROD-037): soft-deleted at confirm; sign-in is refused from here on.
  deletedAt                   DateTime?
  /// PII is anonymized by the purge worker at/after this instant (grace period).
  purgeAfter                  DateTime?
  purgedAt                    DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  accountDeletionRequests     AccountDeletionRequest[]
  driverFeeSettlements        DriverFeeSettlement[]       @relation("DriverFeeSettlementDriver")
  driverFeeSettlementsActed   DriverFeeSettlement[]       @relation("DriverFeeSettlementActor")
  driverTopUps                DriverTopUp[]               @relation("DriverTopUpDriver")
  roleGrants                  RoleGrant[]
  phoneChallenges             PhoneChallenge[]
  emailVerifications          EmailVerification[]
  passwordResets              PasswordReset[]
  emailSignupChallenges       EmailSignupChallenge[]
  passkeys                    Passkey[]
  passkeyChallenges           PasskeyChallenge[]
  sessions                    Session[]
  opsCredential               OpsCredential?
  customerCredential          CustomerCredential?
  customerRides               Ride[]                      @relation("CustomerRides")
  assignedRides               Ride[]                      @relation("AssignedRides")
  dismissedRideRequests       RideRequestDismissal[]      @relation("DismissedRideRequests")
  driverOffers                RideOffer[]                 @relation("DriverOffers")
  rideSelections              RideSelection[]             @relation("CustomerRideSelections")
  ownedStores                 FoodStore[]
  customerFoodOrders          FoodOrder[]                 @relation("CustomerFoodOrders")
  assignedFoodOrders          FoodOrder[]                 @relation("AssignedFoodOrders")
  foodDeliveryOffers          FoodDeliveryOffer[]
  partnerApplications         PartnerApplication[]        @relation("ApplicantPartnerApplications")
  reviewedPartnerApplications PartnerApplication[]        @relation("ReviewedPartnerApplications")
  chatMessages                ChatMessage[]
  driverPresence              DriverPresence?
  opsAuditLogs                OpsAuditLog[]               @relation("OpsAuditActor")
  authMethodPolicies          AuthMethodPolicy[]          @relation("AuthMethodPolicyActor")
  pushDeviceTokens            PushDeviceToken[]
  platformSettings            PlatformSetting[]           @relation("PlatformSettingActor")
  integrationSettings         IntegrationSetting[]        @relation("IntegrationSettingActor")
  opsFaqCreated               OpsFaqEntry[]               @relation("OpsFaqCreatedBy")
  opsFaqUpdated               OpsFaqEntry[]               @relation("OpsFaqUpdatedBy")
  notifications               UserNotification[]
  deviceRegistrations         DeviceRegistration[]
  notificationPreference      UserNotificationPreference?

  savedAddresses     SavedAddress[]
  placeSearchHistory PlaceSearchHistory[]
  ratingsGiven       ServiceRating[]
  jobEarnings        JobEarning[]
  supportTickets     SupportTicket[]      @relation("SupportTicketRequester")

  @@map("users")
}

// FCM device tokens for PushPort (ADR-006). Soft-register from mobile.
model PushDeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @db.VarChar(512)
  platform  String   @default("unknown") @db.VarChar(32)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId])
  @@map("push_device_tokens")
}

// Tracks device-to-account registrations for anti-abuse and multi-account control.
model DeviceRegistration {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @db.VarChar(128)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([deviceId])
  @@index([userId])
  @@map("device_registrations")
}

enum PartnerApplicationRole {
  DRIVER
  MERCHANT
}

enum PartnerApplicationStatus {
  DRAFT
  SUBMITTED
  /// t52u (DRAFT): a reviewer claimed the case; still awaiting a manual decision.
  IN_REVIEW
  APPROVED
  REJECTED
}

// KYC (DRIVER) / KYB (MERCHANT). Mock storage keys live in documents jsonb;
// no real S3 required when KYC_STORAGE_PROVIDER=mock.
model PartnerApplication {
  id           String                   @id @default(uuid()) @db.Uuid
  userId       String                   @db.Uuid
  user         User                     @relation("ApplicantPartnerApplications", fields: [userId], references: [id], onDelete: Cascade)
  role         PartnerApplicationRole
  status       PartnerApplicationStatus
  metadata     Json                     @default("{}")
  documents    Json                     @default("[]")
  reason       String?                  @db.VarChar(500)
  /// Per-section fixes requested by ops on reject (DEC-PROD-020): [{section, note}].
  reviewIssues Json                     @default("[]")
  reviewedBy   String?                  @db.Uuid
  reviewer     User?                    @relation("ReviewedPartnerApplications", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  submittedAt  DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([userId, role])
  @@index([status, submittedAt])
  @@map("partner_applications")
}

model RoleGrant {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  status    RoleGrantStatus
  createdAt DateTime        @default(now())

  @@unique([userId, role])
  @@index([userId])
  @@index([role, status])
  @@map("role_grants")
}

model PhoneChallenge {
  id           String    @id @default(uuid()) @db.Uuid
  // Null until the OTP is verified for a phone that has no account yet.
  userId       String?   @db.Uuid
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone        String
  codeHash     String
  expiresAt    DateTime
  attemptCount Int       @default(0)
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("phone_challenges")
}

model EmailVerification {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  tokenHash    String
  expiresAt    DateTime
  attemptCount Int       @default(0)
  lastSentAt   DateTime  @default(now())
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("email_verifications")
}

enum EmailChallengePurpose {
  SIGNUP
  ACTIVATE_EXISTING
}

model EmailSignupChallenge {
  id           String                @id @default(uuid()) @db.Uuid
  purpose      EmailChallengePurpose @default(SIGNUP)
  // Set only for ACTIVATE_EXISTING: the unverified account the code activates.
  userId       String?               @db.Uuid
  user         User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  // Null when the address already had an account: no usable code was issued.
  passwordHash String?
  displayName  String
  codeHash     String
  expiresAt    DateTime
  attemptCount Int                   @default(0)
  sendCount    Int                   @default(1)
  lastSentAt   DateTime
  consumedAt   DateTime?
  createdAt    DateTime              @default(now())

  @@index([email, createdAt])
  @@map("email_signup_challenges")
}

/// DEC-PROD-045 — forgot password by emailed 6-digit code. userId is null for an address with no
/// password account: the decoy challenge answers like a real one but no code is ever sent.
model PasswordReset {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String?   @db.Uuid
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  /// Hash of the 6-digit code (peppered); never the code itself.
  tokenHash    String
  expiresAt    DateTime
  attemptCount Int       @default(0)
  sendCount    Int       @default(1)
  lastSentAt   DateTime  @default(now())
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([email, createdAt])
  @@map("password_resets")
}

model Passkey {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    Bytes
  counter      Int      @default(0)
  transports   String[] @default([])
  deviceType   String?
  backedUp     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("passkeys")
}

model PasskeyChallenge {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String?             @db.Uuid
  user       User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       PasskeyCeremonyKind
  challenge  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([userId, kind])
  @@map("passkey_challenges")
}

model Session {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @db.Uuid
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId         String               @db.Uuid
  channel          SessionChannel
  refreshTokenHash String               @unique
  expiresAt        DateTime
  rotatedAt        DateTime?
  revokedAt        DateTime?
  revokeReason     SessionRevokeReason?
  deviceId         String?              @db.VarChar(128)
  /// S028 (DEC-PROD-038): client-reported label, e.g. "iPhone · DealGo".
  deviceLabel      String?              @db.VarChar(120)
  userAgent        String?              @db.VarChar(400)
  ipAddress        String?              @db.VarChar(64)
  lastSeenAt       DateTime             @default(now())
  createdAt        DateTime             @default(now())

  @@index([familyId])
  @@index([userId])
  @@index([deviceId])
  @@map("sessions")
}

model OpsCredential {
  userId       String       @id @db.Uuid
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String?
  /// DEC-PROD-036: may reset other ops users' passwords (bootstrap operator).
  superAdmin   Boolean      @default(false)
  /// DEC-PROD-043: coarse ops role; superAdmin bypasses all permission checks.
  staffRole    OpsStaffRole @default(ADMIN)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("ops_credentials")
}

enum OpsStaffRole {
  ADMIN
  SUPPORT
  OPERATIONS
  FINANCE
}

model CustomerCredential {
  userId       String   @id @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("customer_credentials")
}

enum RideStatus {
  NEGOTIATING
  ASSIGNED
  DRIVER_EN_ROUTE
  DRIVER_ARRIVED
  IN_TRIP
  COMPLETED
  CANCELLED
  EXPIRED
}

/// DEC-PROD-035: who cancelled a ride / food order. Driver completion rate only counts DRIVER.
enum CancelActor {
  CUSTOMER
  DRIVER
  MERCHANT
  OPS
  SYSTEM
}

enum RideOfferKind {
  ACCEPT
  COUNTER
}

enum RideOfferStatus {
  PENDING
  SELECTED
  LOST
  /// The customer declined this offer; the driver cannot re-offer on this ride.
  DECLINED
  /// The driver withdrew a pending offer (may offer again while the ride negotiates).
  WITHDRAWN
}

// Partial unique index rides_one_negotiating_per_customer is defined in SQL.
model Ride {
  id                      String                 @id @default(uuid()) @db.Uuid
  customerId              String                 @db.Uuid
  customer                User                   @relation("CustomerRides", fields: [customerId], references: [id], onDelete: Restrict)
  pickupLat               Float
  pickupLng               Float
  pickupLabel             String                 @db.VarChar(160)
  dropoffLat              Float
  dropoffLng              Float
  dropoffLabel            String                 @db.VarChar(160)
  serviceRegionCode       String?                @db.VarChar(8)
  offeredFareVnd          Int
  referenceFareVnd        Int
  /// Class code copied at booking. No FK: disabling a class must not erase history.
  /// OPEN (DG-DEC-VEH-001): historical @default("MOTORBIKE") kept to avoid live migrate;
  /// app/API must set an explicit catalog class on create — do not rely on the DB default.
  /// TODO: migration to drop @default once backfill verified.
  /// No default — every write path passes the class the customer chose.
  vehicleClassCode        String                 @db.VarChar(32)
  agreedFareVnd           Int?
  /// DEC-PROD-024: voucher reserved at offer selection; the customer pays agreedFareVnd - discountVnd.
  discountVnd             Int                    @default(0)
  voucherCode             String?                @db.VarChar(40)
  voucherSponsor          PromotionSponsor?
  status                  RideStatus
  cancelledBy             CancelActor?
  assignedDriverId        String?                @db.Uuid
  assignedDriver          User?                  @relation("AssignedRides", fields: [assignedDriverId], references: [id], onDelete: Restrict)
  selectedOfferId         String?                @unique @db.Uuid
  selectedOffer           RideOffer?             @relation("SelectedOffer", fields: [selectedOfferId], references: [id], onDelete: Restrict)
  expiresAt               DateTime
  /// When the current driver was assigned (late-cancel fee window).
  assignedAt              DateTime?
  /// Last status transition (assignment/en-route timeouts, no-show wait).
  statusChangedAt         DateTime?
  /// Customer did not show up (cancelledBy=CUSTOMER).
  noShow                  Boolean                @default(false)
  /// Reason code for cancellations/returns (driver cancel, timeout, no-show).
  cancelReasonCode        String?                @db.VarChar(40)
  /// Earlier unpaid customer fees collected in this ride's cash (set at completion).
  priorFeesVnd            Int                    @default(0)
  /// Customer fare raises so far; each raise opens a new negotiation round.
  fareRaiseCount          Int                    @default(0)
  /// Customer opt-in: server selects the first live ACCEPT at offeredFareVnd.
  autoAcceptOfferedFare   Boolean                @default(false)
  /// The EXPIRED ride this request re-posts (one-tap re-post).
  repostOfRideId          String?                @db.Uuid
  /// Multi-stop (feature-flagged). Intermediate stops live in ride_stops; pickup/dropoff above stay
  /// the first/last point so single-destination code keeps working. Bumped on every stop edit.
  routeVersion            Int                    @default(0)
  /// t82u: road distance pickup→stops→dropoff (km) priced at booking / last stop edit. Null = legacy row.
  routeDistanceKm         Float?
  stopCount               Int                    @default(0)
  /// Per-stop fee snapshot (already included in referenceFareVnd).
  stopFeeVnd              Int                    @default(0)
  /// Wait policy snapshot at booking (admin changes never touch live rides).
  stopWaitFreeMinutes     Int                    @default(0)
  stopWaitFeeVndPerMinute Int                    @default(0)
  /// Wait fee charged at completion (cash, goes to the driver).
  waitFeeVnd              Int                    @default(0)
  idempotencyKey          String                 @db.VarChar(200)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  offers                  RideOffer[]            @relation("RideOffers")
  requestDismissals       RideRequestDismissal[]
  selections              RideSelection[]
  chatThread              ChatThread?
  pickupCode              RidePickupCode?
  shareLinks              RideShareLink[]
  stops                   RideStop[]
  /// DEC-PROD-071: present when the ride carries goods (Giao hang), not people.
  parcel                  RideParcel?

  @@unique([customerId, idempotencyKey])
  @@index([customerId, status])
  @@index([customerId, createdAt(sort: Desc)], map: "rides_customer_createdAt_idx")
  @@index([status, updatedAt])
  @@index([status, updatedAt(sort: Desc)], map: "rides_status_updatedAt_desc_idx")
  @@index([assignedDriverId, updatedAt(sort: Desc)], map: "rides_driver_history_idx")
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([serviceRegionCode])
  @@index([serviceRegionCode, status, updatedAt])
  @@index([status, vehicleClassCode])
  @@map("rides")
}

/// A driver's durable "Bỏ qua" decision for one open ride request. Dispatch fan-out,
/// re-push and the driver's open feed must all honor this server-side record.
model RideRequestDismissal {
  rideId      String   @db.Uuid
  driverId    String   @db.Uuid
  dismissedAt DateTime @default(now())
  ride        Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver      User     @relation("DismissedRideRequests", fields: [driverId], references: [id], onDelete: Cascade)

  @@id([rideId, driverId])
  @@index([driverId, dismissedAt(sort: Desc)])
  @@map("ride_request_dismissals")
}

/// Intermediate stop of a multi-stop ride, visited in `seq` order (1..n) between pickup and dropoff.
model RideStop {
  id         String    @id @default(uuid()) @db.Uuid
  rideId     String    @db.Uuid
  ride       Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  seq        Int
  lat        Float
  lng        Float
  label      String    @db.VarChar(160)
  arrivedAt  DateTime?
  departedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([rideId, seq])
  @@map("ride_stops")
}

/// Reference fare and bid window for one ride class. Ops-editable.
/// Not an approved OPEN-003 tariff: the customer still bids inside the window.
enum VehicleKind {
  BIKE
  CAR
}

model RideVehicleClass {
  code            String      @id @db.VarChar(32)
  name            String      @db.VarChar(80)
  seats           Int
  enabled         Boolean     @default(true)
  baseFareVnd     Int
  perKmVnd        Int
  perMinuteVnd    Int
  minFareVnd      Int
  maxFareVnd      Int
  assumedSpeedKmh Int
  sortOrder       Int         @default(0)
  /// Public path such as /v1/public/ride-vehicle-classes/MOTORBIKE/<file>.
  imageUrl        String?     @db.VarChar(200)
  /// DEC-PROD-071: class can be booked for parcel delivery (off until ops enables it).
  parcelEnabled   Boolean     @default(false)
  /// RIDE-004/005: BIKE | CAR; drives car KYC documents, licence and commission.
  kind            VehicleKind @default(BIKE)
  updatedByUserId String?     @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("ride_vehicle_classes")
}

/// Per-zone (service region) tariff override for one vehicle class. No row = global class tariff.
/// Only perKm and minFare are overridable; base/perMinute/max stay on the class (owner t50u).
/// `version` bumps on every edit; rides snapshot it (ride_pricing_snapshots).
model RideZoneTariff {
  id               String   @id @default(uuid()) @db.Uuid
  regionCode       String   @db.VarChar(8)
  vehicleClassCode String   @db.VarChar(32)
  perKmVnd         Int
  minFareVnd       Int
  version          Int      @default(1)
  updatedByUserId  String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([regionCode, vehicleClassCode])
  @@map("ride_zone_tariffs")
}

/// Pricing locked onto a ride at booking: which tariff priced it and the bid band then in force.
/// Admin changes to tariffs / band never touch rides that already exist.
model RidePricingSnapshot {
  rideId            String   @id @db.Uuid
  regionCode        String?  @db.VarChar(8)
  /// ZONE = ride_zone_tariffs row, DEFAULT = global class tariff.
  tariffSource      String   @db.VarChar(8)
  zoneTariffId      String?  @db.Uuid
  tariffVersion     Int      @default(0)
  perKmVnd          Int
  minFareVnd        Int
  bidFloorPercent   Int
  bidCeilingPercent Int
  createdAt         DateTime @default(now())

  @@map("ride_pricing_snapshots")
}

/// DEC-PROD-017: server-issued pickup code. Shown only to the ride's customer; the assigned
/// driver must submit it to start the trip. Stored as-is: a 4-digit code gains nothing from
/// hashing (10^4 guesses), so brute force is bounded by `failedAttempts` instead.
model RidePickupCode {
  rideId         String    @id @db.Uuid
  ride           Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  code           String    @db.VarChar(8)
  failedAttempts Int       @default(0)
  createdAt      DateTime  @default(now())
  verifiedAt     DateTime?

  @@map("ride_pickup_codes")
}

enum ParcelSizeClass {
  S
  M
  L
  XL
}

enum ParcelPayer {
  SENDER
  RECIPIENT
}

/// RETURNING = delivery failed, driver brings the goods back; RETURNED = handed back to the sender.
enum ParcelOutcome {
  PENDING
  DELIVERED
  RETURNING
  RETURNED
}

/// DEC-PROD-071 (DRAFT): goods carried by a ride. 1:1 with the ride; lifecycle stays on Ride
/// (NEGOTIATING..IN_TRIP = in transit..COMPLETED) and `outcome` says how it ended.
model RideParcel {
  rideId             String          @id @db.Uuid
  ride               Ride            @relation(fields: [rideId], references: [id], onDelete: Cascade)
  senderName         String          @db.VarChar(80)
  senderPhone        String          @db.VarChar(20)
  recipientName      String          @db.VarChar(80)
  recipientPhone     String          @db.VarChar(20)
  sizeClass          ParcelSizeClass
  weightKg           Float?
  note               String?         @db.VarChar(300)
  payer              ParcelPayer     @default(SENDER)
  /// Size surcharge folded into the reference fare at booking (DRAFT admin setting).
  surchargeVnd       Int             @default(0)
  /// PARCEL_SERVICE_FEE_VND snapshot at booking (folded into the reference fare).
  serviceFeeVnd      Int             @default(0)
  /// PARCEL_RETURN_FEE_VND snapshot at booking; charged as a customer fee on RETURNED.
  returnFeeVnd       Int             @default(0)
  /// StoredDocumentRef jsonb of the optional package photo.
  itemPhoto          Json?
  /// 4-digit code the recipient reads to the driver (only when PARCEL_RECIPIENT_CODE_REQUIRED).
  recipientCode      String?         @db.VarChar(8)
  recipientCodeFails Int             @default(0)
  pickupPhoto        Json?
  pickedUpAt         DateTime?
  deliveryPhoto      Json?
  deliveredAt        DateTime?
  outcome            ParcelOutcome   @default(PENDING)
  failReason         String?         @db.VarChar(40)
  failNote           String?         @db.VarChar(300)
  failedAt           DateTime?
  returnPhoto        Json?
  returnedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([outcome, createdAt])
  @@map("ride_parcels")
}

model RideOffer {
  id              String          @id @default(uuid()) @db.Uuid
  rideId          String          @db.Uuid
  ride            Ride            @relation("RideOffers", fields: [rideId], references: [id], onDelete: Cascade)
  driverId        String          @db.Uuid
  driver          User            @relation("DriverOffers", fields: [driverId], references: [id], onDelete: Restrict)
  amountVnd       Int
  kind            RideOfferKind
  status          RideOfferStatus
  expiresAt       DateTime
  /// Times the driver changed this offer after the first one (RIDE_MAX_OFFER_EDITS_PER_DRIVER).
  editCount       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  selectedForRide Ride?           @relation("SelectedOffer")

  @@unique([rideId, driverId])
  @@map("ride_offers")
}

model RideSelection {
  id             String   @id @default(uuid()) @db.Uuid
  customerId     String   @db.Uuid
  customer       User     @relation("CustomerRideSelections", fields: [customerId], references: [id], onDelete: Restrict)
  idempotencyKey String   @db.VarChar(200)
  rideId         String   @db.Uuid
  ride           Ride     @relation(fields: [rideId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())

  @@unique([customerId, idempotencyKey])
  @@map("ride_selections")
}

enum FoodOrderStatus {
  PLACED
  PREPARING
  READY
  ASSIGNED
  PICKED_UP
  DELIVERED
  FAILED
  CANCELLED
}

enum StoreAcceptMode {
  MANUAL
  AUTO
}

/// DEC-PROD-067 — admin-managed store categories (app chips, labels, home tiles).
/// `code` is generated from the Vietnamese name once and never changes.
model FoodCategory {
  code      String      @id @db.VarChar(64)
  nameVi    String      @db.VarChar(60)
  nameEn    String      @db.VarChar(60)
  /// Lucide icon key from FOOD_CATEGORY_ICONS (shared with the app).
  icon      String      @db.VarChar(32)
  /// Colour key from FOOD_CATEGORY_TONES.
  tone      String      @db.VarChar(16)
  /// Optional square artwork; replaces the icon when set.
  imageUrl  String?     @db.VarChar(300)
  sortOrder Int         @default(0)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  stores    FoodStore[]

  @@index([active, sortOrder])
  @@map("food_categories")
}

model FoodStore {
  id                 String             @id @default(uuid()) @db.Uuid
  ownerId            String             @db.Uuid
  owner              User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name               String             @db.VarChar(120)
  /// DEC-PROD-067 — FoodCategory.code; null = not chosen yet.
  category           String?            @db.VarChar(64)
  categoryRef        FoodCategory?      @relation(fields: [category], references: [code], onDelete: Restrict, onUpdate: Cascade)
  lat                Float?
  lng                Float?
  serviceRegionCode  String?            @db.VarChar(8)
  addressLabel       String?            @db.VarChar(200)
  /// M030 (DEC-PROD-045) — merchant logo, /v1/public/store-logos/<storeId>/<file>.
  logoUrl            String?            @db.VarChar(400)
  /// Merchant cover photo, /v1/public/store-covers/<storeId>/<file>; null = first dish photo.
  coverUrl           String?            @db.VarChar(400)
  /// Merchant "about the store" text; null = none.
  description        String?            @db.VarChar(500)
  /// M024 — merchant-controlled intake mode; PAUSED blocks new orders (DEC-PROD-026).
  serviceMode        StoreServiceMode   @default(OPEN)
  /// Auto-resume to OPEN after this instant; null = until the merchant changes it.
  serviceModeUntil   DateTime?
  /// M023 — false = no hours saved yet → open around the clock (DEC-PROD-027).
  hoursConfigured    Boolean            @default(false)
  /// Stop taking orders this many minutes before closing (M022/M023).
  lastOrderMinutes   Int                @default(0)
  /// M022 — AUTO moves new orders straight to PREPARING (DEC-PROD-028).
  acceptMode         StoreAcceptMode    @default(MANUAL)
  /// Max PLACED+PREPARING orders; null = no cap. Enforced at placement under a store row lock.
  maxActiveOrders    Int?
  defaultPrepMinutes Int                @default(15)
  /// M024 BUSY adds these minutes to the prep estimate.
  busyExtraMinutes   Int                @default(15)
  /// Smallest food subtotal the store accepts (VND); 0 = no minimum. Enforced at placement.
  minOrderVnd        Int                @default(0)
  createdAt          DateTime           @default(now())
  items              FoodItem[]
  menuCategories     FoodMenuCategory[]
  hours              FoodStoreHour[]
  closures           FoodStoreClosure[]
  orders             FoodOrder[]
  promotions         Promotion[]

  @@index([category])
  @@index([lat, lng])
  @@index([serviceRegionCode])
  @@map("food_stores")
}

/// M023 weekly hours, Vietnam local time. A weekday without a row is closed once hours are configured.
model FoodStoreHour {
  storeId      String    @db.Uuid
  store        FoodStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// 1 = Monday … 7 = Sunday
  weekday      Int       @db.SmallInt
  opensMinute  Int       @db.SmallInt
  closesMinute Int       @db.SmallInt

  @@id([storeId, weekday])
  @@map("food_store_hours")
}

/// M023 special closed days (Vietnam calendar date).
model FoodStoreClosure {
  storeId String    @db.Uuid
  store   FoodStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  date    DateTime  @db.Date
  note    String?   @db.VarChar(120)

  @@id([storeId, date])
  @@map("food_store_closures")
}

enum StoreServiceMode {
  OPEN
  BUSY
  PAUSED
}

enum FoodItemModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// M025 (DEC-PROD-039): per-store menu categories the merchant owns and sorts.
model FoodMenuCategory {
  id          String     @id @default(uuid()) @db.Uuid
  storeId     String     @db.Uuid
  store       FoodStore  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String     @db.VarChar(80)
  description String?    @db.VarChar(200)
  position    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       FoodItem[]

  @@index([storeId, position])
  @@map("food_menu_categories")
}

model FoodItem {
  id               String                   @id @default(uuid()) @db.Uuid
  storeId          String                   @db.Uuid
  store            FoodStore                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// M025 — optional menu category; null = uncategorized.
  menuCategoryId   String?                  @db.Uuid
  menuCategory     FoodMenuCategory?        @relation(fields: [menuCategoryId], references: [id], onDelete: SetNull)
  name             String                   @db.VarChar(160)
  /// M027 (DEC-PROD-039).
  description      String?                  @db.VarChar(500)
  priceVnd         Int
  /// List price shown struck through next to priceVnd; null = no markdown. Kept only while above priceVnd.
  originalPriceVnd Int?
  /// Prep estimate shown to customers; null = use store defaultPrepMinutes.
  prepMinutes      Int?
  imageUrl         String?                  @db.VarChar(400)
  /// DEC-PROD-042 — gallery URLs (cover = imageUrl / first entry); capped by MENU_ITEM_MAX_IMAGES.
  imageUrls        Json                     @default("[]")
  /// Completed (DELIVERED) line qty sum; refreshed on delivery.
  soldCount        Int                      @default(0)
  available        Boolean                  @default(true)
  moderationStatus FoodItemModerationStatus @default(PENDING)
  /// When the merchant submitted the item; the Ops catalog review date filter uses it.
  createdAt        DateTime                 @default(now())
  optionGroups     FoodOptionGroup[]

  @@index([storeId])
  @@index([menuCategoryId])
  @@index([moderationStatus])
  @@map("food_items")
}

/// Item option group (size, topping…) with selection bounds (DEC-PROD-033).
model FoodOptionGroup {
  id        String       @id @default(uuid()) @db.Uuid
  itemId    String       @db.Uuid
  item      FoodItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name      String       @db.VarChar(80)
  minSelect Int          @default(0)
  maxSelect Int          @default(1)
  position  Int          @default(0)
  options   FoodOption[]

  @@index([itemId])
  @@map("food_option_groups")
}

model FoodOption {
  id            String          @id @default(uuid()) @db.Uuid
  groupId       String          @db.Uuid
  group         FoodOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name          String          @db.VarChar(80)
  /// Per-unit surcharge added to the item price; never negative.
  priceDeltaVnd Int             @default(0)
  /// Max times this option may appear in one line selection (DEC-PROD-042); 1 = toggle.
  maxQuantity   Int             @default(1) @db.SmallInt
  available     Boolean         @default(true)
  position      Int             @default(0)

  @@index([groupId])
  @@map("food_options")
}

// Partial unique index food_orders_one_open_per_customer is defined in SQL.
model FoodOrder {
  id                       String              @id @default(uuid()) @db.Uuid
  customerId               String              @db.Uuid
  customer                 User                @relation("CustomerFoodOrders", fields: [customerId], references: [id], onDelete: Restrict)
  storeId                  String              @db.Uuid
  store                    FoodStore           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  status                   FoodOrderStatus
  /// Customer's current delivery-fee offer until a driver agrees, then the agreed fee.
  deliveryFareVnd          Int
  /// System suggestion shown at checkout (reference only, never charged by itself).
  suggestedDeliveryFareVnd Int?
  /// Set when a driver accepts the customer's offer or the customer selects a counter.
  deliveryFareAgreedAt     DateTime?
  /// Times the customer raised the offer while waiting for a driver.
  deliveryFareRaiseCount   Int                 @default(0)
  subtotalVnd              Int
  discountVnd              Int                 @default(0)
  voucherCode              String?             @db.VarChar(40)
  /// Who funds discountVnd, snapshotted from the campaign at placement (DEC-PROD-015).
  voucherSponsor           PromotionSponsor?
  totalVnd                 Int
  dropoffLat               Float
  dropoffLng               Float
  dropoffLabel             String              @db.VarChar(160)
  /// Store pickup point snapshotted at placement (DEC-PROD-034); null when the store had no coordinates.
  pickupLat                Float?
  pickupLng                Float?
  pickupLabel              String?             @db.VarChar(200)
  /// Customer note for the store / driver; null = none.
  note                     String?             @db.VarChar(300)
  /// Cutlery requested with this order.
  utensils                 Boolean             @default(true)
  serviceRegionCode        String?             @db.VarChar(8)
  /// Merchant decline reason (FOOD_REJECT_REASONS) and optional note; null unless the store rejected (DEC-PROD-021).
  cancelReasonCode         String?             @db.VarChar(32)
  cancelNote               String?             @db.VarChar(200)
  cancelledBy              CancelActor?
  /// DEC-PROD-036: server-issued delivery / handover codes.
  codes                    FoodOrderCode[]
  assignedDriverId         String?             @db.Uuid
  assignedDriver           User?               @relation("AssignedFoodOrders", fields: [assignedDriverId], references: [id], onDelete: Restrict)
  idempotencyKey           String              @db.VarChar(200)
  /// Prep estimate snapshotted at placement (store default + BUSY extra); null on legacy rows.
  prepMinutes              Int?
  /// Merchant accepted (PLACED→PREPARING); early driver assignment uses acceptedAt + prepMinutes.
  acceptedAt               DateTime?
  /// Merchant marked the order ready (unclaimed-ready timeout).
  readyAt                  DateTime?
  /// Driver picked the order up; failed delivery only after this.
  pickedUpAt               DateTime?
  failedAt                 DateTime?
  /// FOOD_FAIL_REASONS code + note (ShopeeFood failed-order flow).
  failReasonCode           String?             @db.VarChar(32)
  failNote                 String?             @db.VarChar(300)
  /// Cash the driver paid the merchant at pickup (subtotal − merchant-funded discount).
  merchantCashVnd          Int?
  /// Merchant commission snapshot at delivery (percent × 100, and VND).
  merchantCommissionBps    Int?
  merchantCommissionVnd    Int?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  lines                    FoodOrderLine[]
  changes                  FoodOrderChange[]
  deliveryOffers           FoodDeliveryOffer[]
  chatThreads              ChatThread[]

  @@unique([customerId, idempotencyKey])
  @@index([storeId, status])
  @@index([customerId, createdAt(sort: Desc)], map: "food_orders_customer_createdAt_idx")
  @@index([status, updatedAt])
  @@index([status, updatedAt(sort: Desc)], map: "food_orders_status_updatedAt_desc_idx")
  @@index([assignedDriverId, updatedAt(sort: Desc)], map: "food_orders_driver_history_idx")
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([serviceRegionCode])
  @@index([serviceRegionCode, status, updatedAt])
  @@map("food_orders")
}

enum FoodOrderCodeKind {
  DELIVERY
  HANDOVER
}

/// DEC-PROD-036: server-issued food order codes. DELIVERY is shown only to the customer and the
/// assigned driver submits it to deliver (FOOD_DELIVERY_CODE_REQUIRED). HANDOVER is shown only to
/// the merchant and the driver submits it at pickup (FOOD_HANDOVER_CODE_REQUIRED). Brute force is
/// bounded by failedAttempts, like ride_pickup_codes.
model FoodOrderCode {
  orderId        String            @db.Uuid
  order          FoodOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind           FoodOrderCodeKind
  code           String            @db.VarChar(8)
  failedAttempts Int               @default(0)
  createdAt      DateTime          @default(now())
  verifiedAt     DateTime?

  @@id([orderId, kind])
  @@map("food_order_codes")
}

model FoodOrderLine {
  id           String    @id @default(uuid()) @db.Uuid
  orderId      String    @db.Uuid
  order        FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId       String    @db.Uuid
  name         String    @db.VarChar(160)
  /// Base price + chosen option deltas, per unit, at placement.
  unitPriceVnd Int
  quantity     Int
  /// Cover image snapshotted at placement (DEC-PROD-043).
  imageUrl     String?   @db.VarChar(400)
  /// Snapshot of chosen options [{optionId, groupName, name, priceDeltaVnd}] (DEC-PROD-033).
  options      Json      @default("[]")
  /// Customer note for this line ("ít cay, không hành"); null = none.
  note         String?   @db.VarChar(200)

  @@index([orderId])
  @@map("food_order_lines")
}

enum LedgerAccountKind {
  ASSET
  LIABILITY
  /// Platform-funded cost (e.g. DealGo-sponsored vouchers). Sandbox reporting only.
  EXPENSE
  /// Platform income (e.g. platform fee withheld from driver fares). Sandbox reporting only.
  REVENUE
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

enum LedgerEntityType {
  RIDE
  FOOD_ORDER
  DISPUTE
  /// One journal per online refund (multiple partial refunds per intent).
  PAYMENT_REFUND
  /// One PSP capture journal per payment intent (several online payments per job).
  PAYMENT_INTENT
  /// One prepayment capture/refund journal per driver top-up.
  DRIVER_TOP_UP
  /// One journal per Ops settlement that consumed prepaid credit.
  DRIVER_FEE_SETTLEMENT
}

enum LedgerJournalEvent {
  COD_OBLIGATION_POSTED
  /// Sandbox-only refund reverse stub. Not a PSP settlement claim.
  SANDBOX_REFUND_RECORDED
  /// DealGo funds a voucher discount: expense against the amount owed to the merchant.
  PROMOTION_DISCOUNT_FUNDED
  /// Platform fee on a completed COD job: driver owes DealGo the fee (receivable vs revenue).
  DRIVER_PLATFORM_FEE_ACCRUED
  /// Commission the merchant owes DealGo on a delivered food order (receivable vs revenue).
  MERCHANT_COMMISSION_ACCRUED
  /// Verified online payment: PSP clearing receivable vs customer prepayment liability.
  PSP_PAYMENT_CAPTURED
  /// Online refund accepted by the PSP: reverses PSP_PAYMENT_CAPTURED.
  PSP_REFUND_RECORDED
  /// Job completed and was prepaid online: customer prepayment becomes payable to the driver.
  PSP_PREPAID_APPLIED
  /// Refund after the job settled: DealGo absorbs it as an expense (driver keeps the payout).
  PSP_REFUND_AFTER_SETTLEMENT
  /// Verified driver prepayment: money received vs the driver's credit liability.
  DRIVER_CREDIT_TOP_UP_CAPTURED
  /// Prepaid credit offset platform fees at Ops settlement.
  DRIVER_CREDIT_APPLIED_TO_FEE
  /// Ops refunded unused prepaid credit to the driver's verified account.
  DRIVER_CREDIT_REFUNDED
}

enum LedgerJournalStatus {
  POSTED
}

model LedgerAccount {
  id        String            @id @default(uuid()) @db.Uuid
  code      String            @unique @db.VarChar(80)
  name      String            @db.VarChar(160)
  kind      LedgerAccountKind
  createdAt DateTime          @default(now())
  entries   LedgerEntry[]

  @@map("ledger_accounts")
}

model LedgerJournal {
  id         String              @id @default(uuid()) @db.Uuid
  entityType LedgerEntityType
  entityId   String              @db.Uuid
  event      LedgerJournalEvent
  status     LedgerJournalStatus @default(POSTED)
  currency   String              @default("VND") @db.VarChar(3)
  amountVnd  Int
  postedAt   DateTime            @default(now())
  entries    LedgerEntry[]

  @@unique([entityType, entityId, event])
  @@index([entityType, entityId])
  @@map("ledger_journals")
}

model LedgerEntry {
  id        String               @id @default(uuid()) @db.Uuid
  journalId String               @db.Uuid
  journal   LedgerJournal        @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId String               @db.Uuid
  account   LedgerAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  direction LedgerEntryDirection
  amountVnd Int
  createdAt DateTime             @default(now())

  @@index([journalId])
  @@index([accountId])
  @@map("ledger_entries")
}

// Transaction-scoped text chat (DEC-PROD-007 stub). Exactly one of rideId/foodOrderId.
// A food order has two separate threads: customer↔driver (DRIVER) and customer↔shop
// (MERCHANT). Rides only use DRIVER.
model ChatThread {
  id          String        @id @default(uuid()) @db.Uuid
  rideId      String?       @unique @db.Uuid
  ride        Ride?         @relation(fields: [rideId], references: [id], onDelete: Cascade)
  foodOrderId String?       @db.Uuid
  foodOrder   FoodOrder?    @relation(fields: [foodOrderId], references: [id], onDelete: Cascade)
  channel     String        @default("DRIVER") @db.VarChar(16)
  createdAt   DateTime      @default(now())
  messages    ChatMessage[]

  @@unique([foodOrderId, channel])
  @@map("chat_threads")
}

model ChatMessage {
  id             String     @id @default(uuid()) @db.Uuid
  threadId       String     @db.Uuid
  thread         ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUserId   String     @db.Uuid
  sender         User       @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  /// Legacy plaintext; null once encrypted (DRAFT chat at-rest encryption).
  body           String?    @db.VarChar(2000)
  /// base64(iv|tag|ciphertext), AES-256-GCM.
  bodyCiphertext String?    @map("body_ciphertext") @db.Text
  keyVersion     Int?       @map("key_version")
  createdAt      DateTime   @default(now())

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

// Transactional outbox skeleton (ADR-003). Relay fans out Socket.IO + push mock.
model OutboxMessage {
  id             String    @id @default(uuid()) @db.Uuid
  eventKey       String    @unique @db.VarChar(200)
  aggregateType  String    @db.VarChar(64)
  aggregateId    String    @db.Uuid
  eventType      String    @db.VarChar(120)
  payload        Json
  createdAt      DateTime  @default(now())
  processedAt    DateTime?
  attempts       Int       @default(0)
  lockedAt       DateTime?
  /// REL-001: earliest time the relay may retry after a failure (exponential backoff).
  nextAttemptAt  DateTime?
  /// REL-001: set once attempts reach the cap; the row is never claimed again.
  deadLetteredAt DateTime?
  lastError      String?   @db.Text

  @@index([processedAt, createdAt])
  @@index([processedAt, lockedAt])
  @@index([deadLetteredAt])
  @@map("outbox_messages")
}

// Per-user in-app inbox. Rows are written by the outbox relay alongside push fan-out
// (order/ride status changes, campaigns); (userId, sourceEventKey) keeps relay retries idempotent.
model UserNotification {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       String    @db.VarChar(24)
  title          String    @db.VarChar(160)
  body           String    @db.Text
  data           Json?
  sourceEventKey String    @db.VarChar(200)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@unique([userId, sourceEventKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("user_notifications")
}

/// S024 (DEC-PROD-038): per-category push/inbox opt-in. Missing row = defaults (ride/food/chat on, promo/news off).
/// SYSTEM / security notices are always delivered and are not stored here.
model UserNotificationPreference {
  userId      String   @id @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ride        Boolean  @default(true)
  food        Boolean  @default(true)
  chat        Boolean  @default(true)
  promotion   Boolean  @default(false)
  news        Boolean  @default(false)
  /// r26: spoken new-job sound for driver/merchant pushes (off = default sound).
  newJobSound Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@map("user_notification_preferences")
}

// Payment intent (ADR-006). Sandbox COD + redirect create-intent for VNPAY/MOMO.
// Capture without verified webhook is never claimed as settled money.
enum PaymentEntityType {
  RIDE
  FOOD_ORDER
}

enum PaymentMethod {
  COD
  VNPAY
  MOMO
  ZALOPAY
  SHOPEEPAY
  CARD
  APPLE_PAY
  DEALGO_WALLET
}

enum PaymentIntentStatus {
  SANDBOX_RECORDED
  CREATED
  PENDING_REDIRECT
  CAPTURED_STUB
  /// Verified PSP capture (signed IPN/callback).
  CAPTURED
  FAILED
  EXPIRED
  REFUND_PENDING
  REFUNDED
}

model PaymentIntent {
  id                String              @id @default(uuid()) @db.Uuid
  entityType        PaymentEntityType
  entityId          String              @db.Uuid
  method            PaymentMethod
  status            PaymentIntentStatus @default(SANDBOX_RECORDED)
  amountVnd         Int
  currency          String              @default("VND") @db.VarChar(3)
  provider          String              @default("sandbox") @db.VarChar(32)
  providerRef       String?             @db.VarChar(120)
  paymentUrl        String?             @db.VarChar(2000)
  /// Customer-facing method code from the registry (e.g. VNPAY_ATM); null for legacy rows.
  methodCode        String?             @db.VarChar(32)
  /// PSP transaction id needed for refunds (MoMo transId, ZaloPay zp_trans_id, VNPay TransactionNo).
  providerTransId   String?             @db.VarChar(64)
  /// PSP pay date (VNPay vnp_PayDate yyyyMMddHHmmss) needed for refunds.
  providerPayDate   String?             @db.VarChar(20)
  deeplink          String?             @db.VarChar(2000)
  refundedVnd       Int                 @default(0)
  failureReason     String?             @db.VarChar(255)
  /// Set when the completed job consumed this prepayment (PSP_PREPAID_APPLIED posted).
  settledAt         DateTime?
  /// Active reconciliation bookkeeping (provider status query).
  lastReconciledAt  DateTime?
  reconcileAttempts Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  refunds           PaymentRefund[]

  @@unique([entityType, entityId, method])
  @@index([entityType, entityId])
  @@index([providerRef])
  @@index([createdAt])
  @@map("payment_intents")
}

// One row per (partial) refund of a captured online payment.
model PaymentRefund {
  id                String        @id @default(uuid()) @db.Uuid
  paymentIntentId   String        @db.Uuid
  paymentIntent     PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  amountVnd         Int
  /// PENDING | SUCCEEDED | REJECTED
  status            String        @db.VarChar(16)
  requestId         String        @unique @db.VarChar(64)
  /// Client-supplied key (ops Idempotency-Key): a retried/double-submitted refund returns the first one.
  idempotencyKey    String?       @unique @db.VarChar(64)
  providerRefundRef String?       @db.VarChar(120)
  reason            String        @db.VarChar(200)
  actorUserId       String        @db.Uuid
  afterSettlement   Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([paymentIntentId])
  @@map("payment_refunds")
}

// Customer's chosen payment method per ride / food order (registry code, e.g. MOMO, CASH).
model PaymentSelection {
  entityType PaymentEntityType
  entityId   String            @db.Uuid
  methodCode String            @db.VarChar(32)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@id([entityType, entityId])
  @@map("payment_selections")
}

// Idempotent PSP webhook receipts (provider event id).
model PaymentWebhookEvent {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String   @db.VarChar(32)
  providerEventId String   @db.VarChar(160)
  paymentIntentId String?  @db.Uuid
  status          String   @db.VarChar(40)
  createdAt       DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([createdAt])
  @@map("payment_webhook_events")
}

// Optional audit for in-app voice sessions (DEC-PROD-007). Tokens are not stored.
model VoiceSession {
  id            String   @id @default(uuid()) @db.Uuid
  aggregateType String   @db.VarChar(32)
  aggregateId   String   @db.Uuid
  userId        String   @db.Uuid
  roomName      String   @db.VarChar(160)
  provider      String   @db.VarChar(32)
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([aggregateType, aggregateId])
  @@index([userId, createdAt])
  @@map("voice_sessions")
}

// In-app voice call between a customer and the assigned driver of a ride / food order
// (DEC-PROD-007). One open call (RINGING / ACCEPTED) per trip and per callee: partial unique
// indexes voice_calls_one_open_per_aggregate / voice_calls_one_open_per_callee are SQL.
// Audio is never recorded.
model VoiceCall {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @db.VarChar(32)
  aggregateId   String    @db.Uuid
  roomName      String    @db.VarChar(160)
  callerUserId  String    @db.Uuid
  calleeUserId  String    @db.Uuid
  /// CUSTOMER or DRIVER: the caller's side of the trip.
  callerRole    String    @db.VarChar(16)
  /// RINGING, ACCEPTED, DECLINED, MISSED or ENDED.
  status        String    @db.VarChar(16)
  ringUntil     DateTime
  answeredAt    DateTime?
  endedAt       DateTime?
  /// NO_ANSWER, CANCELLED, HANGUP or STALE.
  endReason     String?   @db.VarChar(32)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([aggregateType, aggregateId, createdAt])
  @@index([calleeUserId, createdAt])
  @@map("voice_calls")
}

// Driver online/offline + last known coords for dispatch filtering (ADR-003 presence).
model DriverPresence {
  userId            String    @id @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  online            Boolean
  /// DEC-PROD-023: services the driver takes while online (both on by default).
  rideEnabled       Boolean   @default(true)
  foodEnabled       Boolean   @default(true)
  /// DEC-PROD-071: parcel delivery is opt-in (off by default).
  parcelEnabled     Boolean   @default(false)
  lat               Float?
  lng               Float?
  /// DEC-PROD-031: when lat/lng were last reported (live tracking freshness).
  locationAt        DateTime?
  serviceRegionCode String?   @db.VarChar(8)
  updatedAt         DateTime  @updatedAt

  @@index([online, updatedAt])
  @@index([serviceRegionCode])
  @@map("driver_presence")
}


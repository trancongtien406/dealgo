  DRIVER
  MERCHANT
  STAFF
}

// DRAFT -> PENDING_APPROVAL -> (RUNNING | SENDING) -> SENT. CANCELLED from DRAFT/PENDING/RUNNING.
// Actual fan-out (FCM/SMS/email) is a future worker; this table is the source of truth for state.
enum NotificationCampaignStatus {
  DRAFT
  PENDING_APPROVAL
  RUNNING
  SENDING
  SENT
  CANCELLED
}

model NotificationCampaign {
  id               String                     @id @default(uuid()) @db.Uuid
  code             String                     @unique @db.VarChar(24)
  title            String                     @db.VarChar(160)
  body             String                     @db.Text
  channels         NotificationChannel[]
  audience         NotificationAudience
  audienceNote     String?                    @db.VarChar(160)
  status           NotificationCampaignStatus @default(DRAFT)
  isAutomatic      Boolean                    @default(false)
  scheduledAt      DateTime?
  reachedCount     Int?
  rejectionReason  String?                    @db.VarChar(500)
  submittedAt      DateTime?
  approvedAt       DateTime?
  sentAt           DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  createdByUserId  String?                    @db.Uuid
  updatedByUserId  String?                    @db.Uuid
  approvedByUserId String?                    @db.Uuid

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("notification_campaigns")
}


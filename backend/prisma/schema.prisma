  updatedByUserId String?          @db.Uuid

  @@index([kind, status, createdAt])
  @@map("cms_contents")
}

// ---- Ops disputes / refund requests (Admin Web whenếu nại) ----
enum DisputeStatus {
  OPEN
  AWAITING_RESPONSE
  INVESTIGATING
  RESOLVED
  PENDING
}

enum DisputePriority {
  HIGH
  MEDIUM
  LOW
}

enum DisputeVerifyStatus {
  INVESTIGATING
  RESOLVED
  REJECTED
  WAITING_MERCHANT
}

enum DisputeResolutionKind {
  PARTIAL_REFUND
  FULL_REFUND
  REJECTED
  EVIDENCE_REQUESTED
}

enum RefundRequestStatus {
  PENDING
  SANDBOX_RECORDED
  REJECTED
  CANCELLED
}

enum RefundRequestKind {
  PARTIAL
  FULL
}

model DisputeCase {
  id              String                 @id @default(uuid()) @db.Uuid
  code            String                 @unique @db.VarChar(32)
  type            String                 @db.VarChar(120)
  priority        DisputePriority
  status          DisputeStatus
  verifyStatus    DisputeVerifyStatus    @default(INVESTIGATING)
  orderCode       String                 @db.VarChar(64)
  orderEntityType PaymentEntityType?
  orderEntityId   String?                @db.Uuid
  paymentId       String                 @db.VarChar(64)
  refundCode      String                 @db.VarChar(64)
  assignee        String                 @db.VarChar(120)
  slaRemaining    String                 @default("02:00:00") @db.VarChar(32)
  reporterName    String                 @db.VarChar(160)
  summary         String                 @db.Text
  parties         Json                   @default("[]")
  timeline        Json                   @default("[]")
  messages        Json                   @default("[]")
  checklist       Json                   @default("[]")
  orderSnapshot   Json                   @default("{}")
  resolution      DisputeResolutionKind?
  openedAt        DateTime               @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  refundRequests  RefundRequest[]

  @@index([status, createdAt])
  @@index([priority, createdAt])
  @@index([createdAt])

enum ServiceRegionStatus {
  ACTIVE
  PLANNED
}

// Admin-managed service zones (OPEN-001). `code` is the stable key stored in
// rides/food_orders/food_stores/driver_presence.serviceRegionCode; bbox is a
// coarse classifier, not a production geofence polygon. Rows are never deleted
// (history references the code) — disable by setting status = PLANNED.
model ServiceRegion {
  id          String              @id @default(uuid()) @db.Uuid
  code        String              @unique @db.VarChar(8)
  label       String              @db.VarChar(80)
  centerLat   Float
  centerLng   Float
  minLat      Float
  maxLat      Float
  minLng      Float
  maxLng      Float
  status      ServiceRegionStatus @default(PLANNED)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  homeBanners HomeBanner[]

  @@index([status, sortOrder])
  @@map("service_regions")
}

enum PlatformSettingValueType {
  string
  number
  json
}

// Admin-editable OPEN tunables (TEST_ONLY / PROPOSED). Secrets stay in env.
model PlatformSetting {
  id              String                   @id @default(uuid()) @db.Uuid
  key             String                   @unique @db.VarChar(80)
  value           String                   @db.Text
  valueType       PlatformSettingValueType
  updatedAt       DateTime                 @updatedAt
  updatedByUserId String?                  @db.Uuid
  updatedBy       User?                    @relation("PlatformSettingActor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("platform_settings")
}

enum IntegrationKind {
  EMAIL
  MAPS
  SENTRY
  STORAGE
  SMS
}

// Admin-managed integration credentials (Cài đặt › Email, › Bản đồ, › Sentry). Env values are the
// bootstrap defaults; a field set here overrides its env counterpart. `config` holds non-secret
// fields; `secretsCiphertext` is an AES-256-GCM envelope (SECRETS_ENCRYPTION_KEY) of the secret
// fields and never leaves the server. `testedFingerprint` = config hash of the last passing test.
model IntegrationSetting {
  id                String          @id @default(uuid()) @db.Uuid
  kind              IntegrationKind @unique
  config            Json            @default("{}")
  secretsCiphertext String?         @db.Text
  testedFingerprint String?         @db.VarChar(64)
  testedAt          DateTime?
  updatedAt         DateTime        @updatedAt
  updatedByUserId   String?         @db.Uuid
  updatedBy         User?           @relation("IntegrationSettingActor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("integration_settings")
}

enum EmailSuppressionReason {

  entityType  PromotionRedemptionEntity
  entityId    String                    @db.Uuid
  discountVnd Int
  /// Set when the order is cancelled and the use is returned to the campaign.
  releasedAt  DateTime?
  createdAt   DateTime                  @default(now())

  @@unique([entityType, entityId])
  @@index([promotionId, userId])
  @@map("promotion_redemptions")
}


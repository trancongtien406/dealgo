// ---- Ops disputes / refund requests (Admin Web whenếu nại) ----
enum DisputeStatus {
  OPEN
  AWAITING_RESPONSE
  INVESTIGATING
  RESOLVED
  PENDING
}

enum DisputePriority {
  HIGH
  MEDIUM
  LOW
}

enum DisputeVerifyStatus {
  INVESTIGATING
  RESOLVED
  REJECTED
  WAITING_MERCHANT
}

enum DisputeResolutionKind {
  PARTIAL_REFUND
  FULL_REFUND
  REJECTED
  EVIDENCE_REQUESTED
}

enum RefundRequestStatus {
  PENDING
  SANDBOX_RECORDED
  REJECTED
  CANCELLED
}

enum RefundRequestKind {
  PARTIAL
  FULL
}

model DisputeCase {
  id              String                 @id @default(uuid()) @db.Uuid
  code            String                 @unique @db.VarChar(32)
  type            String                 @db.VarChar(120)
  priority        DisputePriority
  status          DisputeStatus
  verifyStatus    DisputeVerifyStatus    @default(INVESTIGATING)
  orderCode       String                 @db.VarChar(64)
  orderEntityType PaymentEntityType?
  orderEntityId   String?                @db.Uuid
  paymentId       String                 @db.VarChar(64)
  refundCode      String                 @db.VarChar(64)
  assignee        String                 @db.VarChar(120)
  slaRemaining    String                 @default("02:00:00") @db.VarChar(32)
  reporterName    String                 @db.VarChar(160)
  summary         String                 @db.Text
  parties         Json                   @default("[]")
  timeline        Json                   @default("[]")
  messages        Json                   @default("[]")
  checklist       Json                   @default("[]")
  orderSnapshot   Json                   @default("{}")
  resolution      DisputeResolutionKind?
  openedAt        DateTime               @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  refundRequests  RefundRequest[]

  @@index([status, createdAt])
  @@index([priority, createdAt])
  @@index([createdAt])
  @@map("dispute_cases")
}

model RefundRequest {
  id              String              @id @default(uuid()) @db.Uuid
  code            String              @unique @db.VarChar(32)
  disputeId       String              @db.Uuid
  dispute         DisputeCase         @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  kind            RefundRequestKind
  status          RefundRequestStatus @default(PENDING)
  amountVnd       Int
  reason          String              @db.VarChar(500)
  ledgerJournalId String?             @db.Uuid
  createdByUserId String              @db.Uuid
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([disputeId, createdAt])
  @@index([status, createdAt])
  @@map("refund_requests")
}

enum PromotionStatus {
  ACTIVE
  SCHEDULED
  PAUSED
  ENDED
  DRAFT
  CANCELLED
}

enum PromotionServiceType {
  ALL
  RIDE
  FOOD
}

enum PromotionDiscountType {
  FIXED_AMOUNT
  PERCENTAGE
  DELIVERY_DISCOUNT
}

enum PromotionAudience {
  ALL
  CUSTOMER
  DRIVER
  MERCHANT
}

enum PromotionSponsor {
  PLATFORM
  MERCHANT
  SHARED
}

// Amounts are whole VND. PERCENTAGE stores the percent in discountValue.
model Promotion {
  id                String                @id @default(uuid()) @db.Uuid
  code              String                @unique @db.VarChar(40)
  name              String                @db.VarChar(160)
  description       String                @db.Text
  serviceType       PromotionServiceType
  discountType      PromotionDiscountType
  discountValue     Int
  maxDiscountAmount Int?
  minOrderAmount    Int                   @default(0)
  totalBudget       Int
  usedBudget        Int                   @default(0)
  usageLimit        Int
  usedCount         Int                   @default(0)
  userLimit         Int                   @default(1)
  targetAudience    PromotionAudience     @default(ALL)
  status            PromotionStatus       @default(ACTIVE)
  startDate         DateTime
  endDate           DateTime
  sponsor           PromotionSponsor      @default(PLATFORM)
  /// Set for a store's own offer (merchant-created, FOOD only, MERCHANT-funded):
  /// it applies only to orders from this store. Null = DealGo campaign.
  storeId           String?               @db.Uuid
  store             FoodStore?            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  redemptions       PromotionRedemption[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([storeId, status])
  @@map("promotions")
}

enum PromotionRedemptionEntity {
  FOOD_ORDER
  RIDE
}

// One row per order that consumed a voucher. Written in the same transaction as the
// order, after locking the promotion row, so usageLimit/userLimit/budget hold under races.
model PromotionRedemption {
  id          String                    @id @default(uuid()) @db.Uuid
  promotionId String                    @db.Uuid
  promotion   Promotion                 @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  userId      String                    @db.Uuid
  entityType  PromotionRedemptionEntity
  entityId    String                    @db.Uuid
  discountVnd Int
  /// Set when the order is cancelled and the use is returned to the campaign.
  releasedAt  DateTime?
  createdAt   DateTime                  @default(now())

  @@unique([entityType, entityId])
  @@index([promotionId, userId])
  @@map("promotion_redemptions")
}

enum SavedAddressKind {
  HOME
  WORK
  OTHER
}

/// Customer address book. One HOME, one WORK, one default per user (enforced in the service
/// under a per-user row lock); at most 20 rows. Coordinates are optional (pin may be added later).
model SavedAddress {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        SavedAddressKind
  label       String           @db.VarChar(60)
  addressLine String           @db.VarChar(300)
  note        String?          @db.VarChar(200)
  lat         Float?
  lng         Float?
  isDefault   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_addresses")
}

// Places a user picked from search (server-side so it survives reinstalls).
// One row per place (placeKey = folded name + ~110 m cell); the service keeps
// the newest 20 per user. Only places the user chose are stored, never raw
// provider result lists.
model PlaceSearchHistory {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeKey   String   @db.VarChar(200)
  name       String   @db.VarChar(160)
  address    String   @db.VarChar(300)
  lat        Float
  lng        Float
  useCount   Int      @default(1)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, placeKey])
  @@index([userId, lastUsedAt(sort: Desc)])
  @@map("place_search_history")
}

enum HomeBannerService {
  ALL
  RIDE
  FOOD
}

enum HomeBannerAudience {
  CUSTOMER
  DRIVER
  MERCHANT
}

// Admin-managed home-screen banners. A banner shows on the home of every role in
// `audiences` while active and inside [startsAt, endsAt); `regionCode` null = all
// regions. `ctaUrl` is an allowlisted in-app path (/customer/..., dealgo://...) or https.
model HomeBanner {
  id              String                @id @default(uuid()) @db.Uuid
  imageUrl        String?               @db.VarChar(300)
  ctaUrl          String?               @db.VarChar(500)
  audiences       HomeBannerAudience[]
  service         HomeBannerService     @default(ALL)
  regionCode      String?               @db.VarChar(8)
  region          ServiceRegion?        @relation(fields: [regionCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  startsAt        DateTime?
  endsAt          DateTime?
  sortOrder       Int                   @default(0)
  active          Boolean               @default(false)
  createdByUserId String?               @db.Uuid
  updatedByUserId String?               @db.Uuid
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  stats           HomeBannerDailyStat[]

  @@index([active, sortOrder])
  @@index([regionCode])
  @@map("home_banners")
}

// Impression / click counters per banner per day (Asia/Ho_Chi_Minh calendar day).
model HomeBannerDailyStat {
  bannerId    String     @db.Uuid
  banner      HomeBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  day         DateTime   @db.Date
  impressions Int        @default(0)
  clicks      Int        @default(0)

  @@id([bannerId, day])
  @@map("home_banner_daily_stats")
}

enum RatingSubjectType {
  RIDE
  FOOD_ORDER
}

/// Driver earnings snapshot of one completed ride / delivered food order (1:1 with the job).
/// The platform fee rate is copied at completion so later setting changes never rewrite history.
/// feeBps = percent x 100 (e.g. 12.5 % = 1250).
model JobEarning {
  id          String           @id @default(uuid()) @db.Uuid
  entityType  LedgerEntityType
  entityId    String           @db.Uuid
  driverId    String           @db.Uuid
  driver      User             @relation(fields: [driverId], references: [id], onDelete: Restrict)
  fareVnd     Int
  feeBps      Int
  feeVnd      Int
  netVnd      Int
  completedAt DateTime
  createdAt   DateTime         @default(now())

  @@unique([entityType, entityId])
  @@index([driverId, completedAt(sort: Desc)])
  @@map("job_earnings")
}

/// Customer rating of a finished ride or delivered food order (one per subject).
/// driverId/storeId are snapshots of who handled it, for driver summaries and history.
model ServiceRating {
  id            String            @id @default(uuid()) @db.Uuid
  subjectType   RatingSubjectType
  subjectId     String            @db.Uuid
  raterId       String            @db.Uuid
  rater         User              @relation(fields: [raterId], references: [id], onDelete: Cascade)
  driverId      String?           @db.Uuid
  storeId       String?           @db.Uuid
  driverStars   Int?              @db.SmallInt
  storeStars    Int?              @db.SmallInt
  tags          String[]          @db.VarChar(40)
  comment       String?           @db.VarChar(500)
  createdAt     DateTime          @default(now())
  /// The store's one public answer to a food review (editable).
  merchantReply String?           @db.VarChar(500)
  repliedAt     DateTime?
  /// Ops moderation: hidden reviews leave the public list and the store average.
  hiddenAt      DateTime?
  hiddenReason  String?           @db.VarChar(500)

  @@unique([subjectType, subjectId])
  @@index([driverId, createdAt(sort: Desc)])
  @@index([storeId])
  @@map("service_ratings")
}


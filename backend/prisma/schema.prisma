}

model RefundRequest {
  id              String              @id @default(uuid()) @db.Uuid
  code            String              @unique @db.VarChar(32)
  disputeId       String              @db.Uuid
  dispute         DisputeCase         @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  kind            RefundRequestKind
  status          RefundRequestStatus @default(PENDING)
  amountVnd       Int
  reason          String              @db.VarChar(500)
  ledgerJournalId String?             @db.Uuid
  createdByUserId String              @db.Uuid
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([disputeId, createdAt])
  @@index([status, createdAt])
  @@map("refund_requests")
}

enum PromotionStatus {
  ACTIVE
  SCHEDULED
  PAUSED
  ENDED
  DRAFT
  CANCELLED
}

enum PromotionServiceType {
  ALL
  RIDE
  FOOD
}

enum PromotionDiscountType {
  FIXED_AMOUNT
  PERCENTAGE
  DELIVERY_DISCOUNT
}

enum PromotionAudience {
  ALL
  CUSTOMER
  DRIVER
  MERCHANT
}

enum PromotionSponsor {
  PLATFORM
  MERCHANT
  SHARED
}

// Amounts are whole VND. PERCENTAGE stores the percent in discountValue.
model Promotion {
  id                String                @id @default(uuid()) @db.Uuid
  code              String                @unique @db.VarChar(40)
  name              String                @db.VarChar(160)

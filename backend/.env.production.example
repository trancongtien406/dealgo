# Production backend env: placeholders only, never commit real values.
# Everything not listed keeps the .env.example default. NODE_ENV=production makes the server
# refuse to boot on missing or mock providers (see docs/09-operations/secrets-and-env-catalog.md).
NODE_ENV=production
DEPLOY_ENV=production
DATABASE_URL=
REDIS_URL=
JWT_ACCESS_SECRET=
CHAT_ENCRYPTION_KEY=
PUBLIC_WEB_BASE_URL=https://dealgo.laptrinhapp.com
WEBAUTHN_RP_ID=dealgo.laptrinhapp.com
WEBAUTHN_RP_NAME=DealGo
WEBAUTHN_ORIGIN=https://dealgo.laptrinhapp.com
APP_LINKS_IOS_APP_IDS=6J3522877H.com.nguyenngoctien.dealgo
APP_LINKS_ANDROID_PACKAGE=com.nguyenngoctien.dealgo
APP_LINKS_ANDROID_CERT_SHA256=

MAPS_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
ROUTING_PROVIDER=mapbox
MAPBOX_DIRECTIONS_TOKEN=

SMS_PROVIDER=esms
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
EMAIL_PROVIDER=ses
EMAIL_FROM=DealGo <noreply@dealgo.vn>
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# Push: FCM for every normal push (the APNs .p8 below is also uploaded to Firebase Console →
# Project settings → Cloud Messaging → Apple app configuration).
PUSH_PROVIDER=fcm
FCM_SERVICE_ACCOUNT_PATH=
# or FCM_PROJECT_ID / FCM_CLIENT_EMAIL / FCM_PRIVATE_KEY

# iOS PushKit (VoIP) incoming calls. Blank APNS_KEY_PATH = VoIP off (calls ring via FCM).
# A half-filled setup (missing/unreadable key, missing team id, bad APNS_ENV) stops boot.
APNS_KEY_ID=TL36K38ZKR
APNS_TEAM_ID=6J3522877H
APNS_KEY_PATH=
APNS_BUNDLE_ID=com.nguyenngoctien.dealgo
APNS_ENV=production

PAYMENT_PROVIDER=cash-only
# LiveKit: self-hosted kit in deploy/livekit (docs/09-operations/livekit-self-host.md).
# deploy/livekit/gen-keys.sh writes these three lines to backend.env.snippet. Boot fails on ws:// or a secret < 32 chars.
VOICE_PROVIDER=livekit
LIVEKIT_URL=wss://livekit.<your-domain>
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

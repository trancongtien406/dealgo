# Copy to backend/.env. Never commit backend/.env.
# Production boot refuses the development JWT secret, SMS_PROVIDER=mock,
# PUSH_PROVIDER=mock, and VOICE_PROVIDER=mock.

NODE_ENV=development
PORT=3001
# OpenAPI UI at /docs. Defaults on when NODE_ENV is not production.
# SWAGGER_ENABLED=true


# Local Docker Compose defaults. Replace before any shared environment.
# docker-compose maps Postgres to host port 5433 (avoids clash with local Postgres on 5432).
DATABASE_URL=postgresql://dealgo:dealgo_dev@127.0.0.1:5433/dealgo?schema=public
# Max Postgres connections per process (API and worker each get one pool). Default 10.
# Keep (API + worker instances) x this value under the server/pooler connection limit.
DATABASE_POOL_MAX=10
# Max wait for a free connection before a query fails (ms). Default 10000.
DATABASE_CONNECT_TIMEOUT_MS=10000
REDIS_URL=redis://localhost:6379

# Development only. Generate a unique secret for staging and production.
JWT_ACCESS_SECRET=dev-only-change-me
# Access JWT lifetime (seconds). Default 3600 (1h). Refresh rotates via
# POST /v1/auth/sessions/refresh; Admin BFF keeps HttpOnly cookies in sync.
JWT_ACCESS_TTL_SECONDS=3600
# Refresh JWT lifetime (seconds). Default 1209600 (~14 days).
JWT_REFRESH_TTL_SECONDS=1209600

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=DealGo
# Comma-separated web origins. Prod: WEBAUTHN_RP_ID=<APP_LINK_HOST>, WEBAUTHN_ORIGIN=https://<APP_LINK_HOST>
WEBAUTHN_ORIGIN=http://localhost:3000
# Universal/App Links + passkey association served at /.well-known/* (DEC-PROD-058). Blank = 404.
# iOS: comma list of <TEAMID>.<bundle id>. Android: package + comma list of release cert SHA-256 (AA:BB:..).
APP_LINKS_IOS_APP_IDS=
APP_LINKS_ANDROID_PACKAGE=
APP_LINKS_ANDROID_CERT_SHA256=
# Comma list of paths for applinks (default /app/*)
APP_LINKS_PATHS=

MAPS_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
# mock | mapbox | goong | google — mapbox uses MAPBOX_ACCESS_TOKEN (pk.*) for geocode/search/reverse
GOONG_API_KEY=
# Optional second provider, chosen per capability in Admin › Cài đặt › Bản đồ
# (MAPS_SEARCH/REVERSE/ROUTE_PROVIDER). Server-only key with Places API (New),
# Geocoding API and Routes API enabled. Blank = Google disabled, Mapbox serves everything.
GOOGLE_MAPS_API_KEY=

# DEC-PROD-045 (+ mobile DRAFT wiring): road geometry via Nest for Admin AND app.
# Owner preference (2026-10-23): prefer Mapbox Directions when a server token is available.
#   Preferred: ROUTING_PROVIDER=mapbox + MAPBOX_DIRECTIONS_TOKEN=… (server-only; never ship to clients).
#   Fallback:  ROUTING_PROVIDER=osrm + ROUTING_OSRM_URL=… (self-hosted). Public demo OSRM = DEV only — not production.
#   none (code default if unset/invalid): straight-line + illustrative watermark.
# Optional Photon (OpenStreetMap) search merged into place search: OSM has the city
# street grid Mapbox VN lacks. Empty = Mapbox-only. Production: a self-hosted Photon with
# a Vietnam extract (docs/architecture/places-search.md). The public
# https://photon.komoot.io is fair-use, for local dev only, never production traffic.
PLACES_OSM_SEARCH_URL=
# Nest MapsPort (MAPS_PROVIDER=mapbox) reads MAPBOX_ACCESS_TOKEN; RoutingService reads MAPBOX_DIRECTIONS_TOKEN.
# NEXT_PUBLIC_MAPBOX_TOKEN is Admin web tiles only — do not confuse with Nest.
ROUTING_PROVIDER=mapbox
ROUTING_OSRM_URL=
MAPBOX_DIRECTIONS_TOKEN=
ROUTING_TIMEOUT_MS=4000

SMS_PROVIDER=mock
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
# Auth methods are toggled in admin; a provider is only required in production for enabled methods.
# SMS_PROVIDER: none | mock (non-prod) | esms (primary, DEC-PROD-050) | speedsms
# ESMS_SMS_TYPE=2
# ESMS_SANDBOX=false
# ESMS_BASE_URL=https://rest.esms.vn
SPEEDSMS_ACCESS_TOKEN=
# Blank sender = SpeedSMS shared "Verify" sender (type 4)
SPEEDSMS_SENDER=
# SPEEDSMS_SMS_TYPE=
# SPEEDSMS_BASE_URL=https://api.speedsms.vn
# Must match the carrier-registered template; {code} and {minutes} are replaced.
# SMS_OTP_TEMPLATE=
# SMS_HTTP_TIMEOUT_MS=8000

# EMAIL_PROVIDER: none | mock (non-prod) | smtp (any SMTP incl. SES/Brevo SMTP) | ses (SES v2 HTTPS API, DEC-PROD-051)
# Bootstrap only: provider, sender and credentials saved in Admin › Cài đặt › Email override these.
EMAIL_PROVIDER=mock
EMAIL_FROM=
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
# EMAIL_HTTP_TIMEOUT_MS=10000
# Prefer SMTP_URL. Discrete SMTP_* are folded into SMTP_URL when SMTP_URL is empty.
SMTP_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=DealGo <noreply@example.com>
# SMTP_TLS=true

# mock (non-prod) | fcm (HTTP v1). Prefer a service-account JSON path over pasting PEM.
PUSH_PROVIDER=mock
# Relative to backend/ cwd (where nest/vitest run). Also accepts GOOGLE_APPLICATION_CREDENTIALS.
# FCM_SERVICE_ACCOUNT_PATH=./dealgo-xxxxx-firebase-adminsdk-xxxxx.json
# GOOGLE_APPLICATION_CREDENTIALS=
# Optional explicit fields (used when set; otherwise loaded from the JSON path above).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# PEM with literal \n escapes is accepted.
FCM_PRIVATE_KEY=
# iOS PushKit (VoIP) incoming calls via APNs token auth (team-scoped .p8 key, Sandbox &
# Production; the same .p8 is uploaded to Firebase for normal iOS pushes). Key id and team id
# are not secret. Until APNS_KEY_PATH points at the .p8, VoIP stays off and calls ring
# through the FCM alert push only. Never commit the .p8 (*.p8 is git-ignored).
APNS_KEY_ID=57D64GX72T
APNS_TEAM_ID=NN36XDL3V6
APNS_KEY_PATH=
# or paste the key instead of a file: APNS_PRIVATE_KEY=<PEM with \n escapes>
APNS_BUNDLE_ID=com.nguyenngoctien.dealgo
# sandbox (Xcode debug builds) | production (TestFlight / App Store). Default: production
# when NODE_ENV=production, else sandbox.
APNS_ENV=sandbox

# sandbox (default COD PaymentIntent) | vnpay | momo — create redirect intent only; capture needs webhook.
PAYMENT_PROVIDER=sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
# Multi-method checkout (placeholders only; real values live in the secret store)
PAYMENT_PUBLIC_BASE_URL=
PAYMENT_APP_RETURN_URL=dealgo://payment-return
VNPAY_API_URL=
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=
SHOPEEPAY_CLIENT_ID=
SHOPEEPAY_SECRET_KEY=
SHOPEEPAY_MERCHANT_EXT_ID=
SHOPEEPAY_ENDPOINT=
CARD_GATEWAY_MERCHANT_ID=
CARD_GATEWAY_SECRET=
APPLE_PAY_MERCHANT_ID=

# Driver prepaid platform fees (DEC-PROD-093). Provider: payos (default) | vnpay.
# payOS creates payment links only; money settles to the merchant bank account (A2A).
# Enable/limits live in Admin settings (DRIVER_TOP_UP_*), not in this file.
DRIVER_TOP_UP_PROVIDER=payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_ENDPOINT=https://api-merchant.payos.vn

# In-app voice calls customer <-> assigned driver (DEC-PROD-007, DEC-PROD-064). Audio only, no recording.
# none/unset = calls off (API answers VOICE_UNAVAILABLE) | mock = fake tokens for tests, no audio
# | livekit = real calls. Local dev: `docker compose up -d livekit`, then
#   VOICE_PROVIDER=livekit, LIVEKIT_URL=ws://<LAN IP of this machine>:7880 (phones cannot reach
#   localhost), LIVEKIT_API_KEY=devkey, LIVEKIT_API_SECRET=secret (livekit-server --dev defaults).
# Production: wss:// URL and your own key + secret (>= 32 chars); boot fails otherwise.
VOICE_PROVIDER=none
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Upload storage for KYC/KYB documents and ticket attachments (DEC-PROD-020).
# memory (tests) | local (dev, single instance) | s3 (S3/R2/MinIO, needs S3_* below).
# Unset: development → local, test → memory, production → uploads return 503.
# Size/type limits are admin settings UPLOAD_MAX_FILE_KB / UPLOAD_ALLOWED_TYPES.
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_DIR=./var/object-storage
# Legacy: KYC_STORAGE_PROVIDER=s3 still selects s3 when OBJECT_STORAGE_PROVIDER is unset.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
# Alias accepted: S3_BUCKET_NAME → S3_BUCKET
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# R19 (gap 20): local | staging | production. Unset = production when NODE_ENV=production, else local.
# DEPLOY_ENV=local

# DEC-PROD-070 (t61u): unset = false everywhere (KYC/KYB gate enforced, incl. local).
# Local dev only: set PARTNER_ELIGIBILITY_BYPASS=true to skip the gate for quick testing.
# PARTNER_ELIGIBILITY_BYPASS=true is rejected at boot when NODE_ENV or DEPLOY_ENV is production.
# PARTNER_ELIGIBILITY_BYPASS=true


# Food delivery quote (TEST_ONLY): server computes fare from distance × per-km,
# then clamps to FOOD_MIN/MAX. Client-supplied deliveryFareVnd is ignored.
# FOOD_DELIVERY_VND_PER_KM=3000
# FOOD_MIN_DELIVERY_VND / FOOD_MAX_DELIVERY_VND also editable via Admin platform-settings.

# OPEN tunables (fare bounds, radius, offer TTL, contact window, payment channel
# flags, pilot label, max concurrent jobs) are NOT listed here — edit in Admin
# (GET/PATCH /v1/ops/platform-settings). Code defaults apply until a DB row exists.
# Do not put PSP/JWT/FCM/LiveKit/SMS/S3 secrets in Admin.

# Phone OTP challenge/verify rate limit. RedisThrottlerStorage when REDIS_URL is set; else memory.
OTP_THROTTLE_TTL_MS=60000
OTP_THROTTLE_LIMIT=10
# DEC-PROD-044: SMS OTP sends per phone number per window (in addition to the per-IP limit).
OTP_PHONE_LIMIT=5
OTP_PHONE_WINDOW_MS=900000

# Background workers: BullMQ when REDIS_URL is up; interval fallback in non-prod.
RIDE_EXPIRY_INTERVAL_MS=5000
OUTBOX_RELAY_INTERVAL_MS=2000
# DEC-PROD-022: orphan-upload sweep interval (6 h). Age threshold: admin setting UPLOAD_ORPHAN_MAX_AGE_HOURS.
UPLOAD_ORPHAN_CLEANUP_INTERVAL_MS=21600000
# DEC-PROD-037: account purge sweep (grace period itself is the Admin setting ACCOUNT_DELETION_GRACE_DAYS)
ACCOUNT_PURGE_INTERVAL_MS=3600000

# Local only. Creates one OPS operator on startup when both values are set.
# The API refuses to bootstrap when NODE_ENV=production and the password is
# still change-me-dev-only. Do not copy these into a shared environment.
OPS_BOOTSTRAP_EMAIL=ops@localhost
OPS_BOOTSTRAP_PASSWORD=change-me-dev-only

# Demo directory data for Admin (ADMIN_UI_MOCK=0): npm run seed
# Upserts customers/drivers/stores/rides/food-orders/partner applications.

# Public website origin used to build trip share links (/chia-se-chuyen/{token}).
PUBLIC_WEB_BASE_URL=http://localhost:3000

# DEC-PROD-031 rev 2026-10-24 — adaptive driver GPS (DRAFT defaults; server returns policy to app)
DRIVER_LOCATION_ON_TRIP_INTERVAL_MS=5000
DRIVER_LOCATION_IDLE_INTERVAL_MS=15000
DRIVER_LOCATION_ON_TRIP_MIN_DISTANCE_M=10
DRIVER_LOCATION_IDLE_MIN_DISTANCE_M=50
DRIVER_LOCATION_MAX_SILENCE_MS=30000
DRIVER_LOCATION_MIN_ACCEPT_INTERVAL_MS=1000

# Chat at-rest encryption (AES-256-GCM). Base64 of 32 random bytes: `openssl rand -base64 32`.
# REQUIRED when NODE_ENV=production (app refuses to start). Blank in dev = plaintext (warning: dev only).
# Runbook: docs/09-operations/chat-encryption-keys.md
CHAT_ENCRYPTION_KEY=
CHAT_ENCRYPTION_KEY_VERSION=1

# Old keys kept for decrypt during rotation: "1:<base64>,2:<base64>"
CHAT_ENCRYPTION_PREVIOUS_KEYS=

# Encrypts credentials saved in Admin (Cài đặt › Email, Cài đặt › Bản đồ). Base64 of 32 bytes:
#   openssl rand -base64 32
# Unset → Admin shows env values but cannot save credentials. Changing it makes saved ones unreadable.
SECRETS_ENCRYPTION_KEY=

# App Store / Play review sign-in (DEC-PROD-052). 6 digits; only accepted for the review phone/email
# set in admin settings while APP_REVIEW_LOGIN_ENABLED=true. Audited and rate-limited.
APP_REVIEW_OTP_CODE=

# Reverse proxy hops (DEC-PROD-053): blank/false = direct; 1 = behind one load balancer; or CSV of subnets.
TRUST_PROXY=

# Monitoring (DEC-PROD-053/054). Blank SENTRY_DSN = Sentry off. LOG_FORMAT: text | json (default json in production).
SENTRY_DSN=
# Prod: SENTRY_ENVIRONMENT=production, SENTRY_TRACES_SAMPLE_RATE=0.1, SENTRY_RELEASE=<deploy tag>.
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
LOG_FORMAT=
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_HEARTBEAT_STALE_MS=60000
OUTBOX_LAG_ALERT_MS=60000
# Slack/Discord-style incoming webhook for ops alerts (worker down, outbox lag). Blank = log only.
OPS_ALERT_WEBHOOK_URL=

# Chat retention purge cadence (DEC-PROD-056). Retention days are an admin setting (default 90).
CHAT_RETENTION_PURGE_INTERVAL_MS=3600000
# KYC liveness-clip purge cadence (DEC-PROD-070). Retention days: admin setting KYC_VIDEO_RETENTION_DAYS (default 90).
KYC_MEDIA_RETENTION_INTERVAL_MS=3600000

# Online payment reconciliation: queries MoMo/ZaloPay/VNPay status for attempts stuck pending.
PAYMENT_RECONCILE_INTERVAL_MS=120000

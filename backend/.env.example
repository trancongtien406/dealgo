# Copy to backend/.env. Never commit backend/.env.
# Production boot refuses the development JWT secret, SMS_PROVIDER=mock,
# PUSH_PROVIDER=mock, and VOICE_PROVIDER=mock.

NODE_ENV=development
PORT=3001
# OpenAPI UI at /docs. Defaults on when NODE_ENV is not production.
# SWAGGER_ENABLED=true


# Local Docker Compose defaults. Replace before any shared environment.
# docker-compose maps Postgres to host port 5433 (avoids clash with local Postgres on 5432).
DATABASE_URL=postgresql://dealgo:dealgo_dev@127.0.0.1:5433/dealgo?schema=public
REDIS_URL=redis://localhost:6379

# Development only. Generate a unique secret for staging and production.
JWT_ACCESS_SECRET=dev-only-change-me
# Access JWT lifetime (seconds). Default 3600 (1h). Refresh rotates via
# POST /v1/auth/sessions/refresh; Admin BFF keeps HttpOnly cookies in sync.
JWT_ACCESS_TTL_SECONDS=3600
# Refresh JWT lifetime (seconds). Default 1209600 (~14 days).
JWT_REFRESH_TTL_SECONDS=1209600

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=DealGo
WEBAUTHN_ORIGIN=http://localhost:3000

MAPS_PROVIDER=mock
GOONG_API_KEY=
GOOGLE_MAPS_API_KEY=

SMS_PROVIDER=mock
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

EMAIL_PROVIDER=mock
# Prefer SMTP_URL. Discrete SMTP_* are folded into SMTP_URL when SMTP_URL is empty.
SMTP_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=DealGo <noreply@example.com>
# SMTP_TLS=true

# mock (non-prod) | fcm (HTTP v1). Prefer a service-account JSON path over pasting PEM.
PUSH_PROVIDER=mock
# Relative to backend/ cwd (where nest/vitest run). Also accepts GOOGLE_APPLICATION_CREDENTIALS.
# FCM_SERVICE_ACCOUNT_PATH=./dealgo-xxxxx-firebase-adminsdk-xxxxx.json
# GOOGLE_APPLICATION_CREDENTIALS=
# Optional explicit fields (used when set; otherwise loaded from the JSON path above).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# PEM with literal \n escapes is accepted.
FCM_PRIVATE_KEY=

# sandbox (default COD PaymentIntent) | vnpay | momo — create redirect intent only; capture needs webhook.
PAYMENT_PROVIDER=sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=

# mock (non-prod) | livekit (needs LIVEKIT_*). Audio-only; no recording/video (DEC-PROD-007).
VOICE_PROVIDER=mock
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# mock (non-prod) | s3 (requires S3_* below; fail-closed if incomplete)
KYC_STORAGE_PROVIDER=mock
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
# Alias accepted: S3_BUCKET_NAME → S3_BUCKET
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# When unset: bypass KYC/KYB gate outside production after ACTIVE grant.
# Set false locally to exercise PARTNER_KYC_REQUIRED.
# PARTNER_ELIGIBILITY_BYPASS=true

# Food delivery quote (TEST_ONLY): server computes fare from distance × per-km,
# then clamps to FOOD_MIN/MAX. Client-supplied deliveryFareVnd is ignored.
# FOOD_DELIVERY_VND_PER_KM=3000
# FOOD_MIN_DELIVERY_VND / FOOD_MAX_DELIVERY_VND also editable via Admin platform-settings.

# OPEN tunables (fare bounds, radius, offer TTL, contact window, payment channel
# flags, pilot label, max concurrent jobs) are NOT listed here — edit in Admin
# (GET/PATCH /v1/ops/platform-settings). Code defaults apply until a DB row exists.
# Do not put PSP/JWT/FCM/LiveKit/SMS/S3 secrets in Admin.

# Phone OTP challenge/verify rate limit. RedisThrottlerStorage when REDIS_URL is set; else memory.
OTP_THROTTLE_TTL_MS=60000
OTP_THROTTLE_LIMIT=10

# Background workers: BullMQ when REDIS_URL is up; interval fallback in non-prod.
RIDE_EXPIRY_INTERVAL_MS=5000
OUTBOX_RELAY_INTERVAL_MS=2000

# Local only. Creates one OPS operator on startup when both values are set.
# The API refuses to bootstrap when NODE_ENV=production and the password is
# still change-me-dev-only. Do not copy these into a shared environment.
OPS_BOOTSTRAP_EMAIL=ops@localhost
OPS_BOOTSTRAP_PASSWORD=change-me-dev-only

# Demo directory data for Admin (ADMIN_UI_MOCK=0): npm run seed
# Upserts customers/drivers/stores/rides/food-orders/partner applications.

{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "prisma:generate": "prisma generate",
    "prebuild": "prisma generate",
    "pretest": "prisma generate",
    "pretest:e2e": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "seed:scale": "tsx prisma/seed-scale.ts",
    "seed:showcase": "tsx prisma/seed-dev-showcase.ts",
    "seed:app-review": "tsx prisma/seed-app-review.ts",
    "images:backfill": "tsx prisma/backfill-image-variants.ts",
    "seed:app-review:cleanup": "tsx prisma/seed-app-review-cleanup.ts",
    "chat:encrypt-backfill": "tsx scripts/chat-encrypt-backfill.ts",
    "auth-methods": "tsx scripts/auth-methods.ts",
    "seed:scale:continue": "tsx prisma/seed-scale-continue.ts",
    "seed:heal-food-lines": "tsx prisma/seed-food-order-lines.ts",
    "seed:heal-negotiations": "tsx prisma/seed-heal-negotiations.ts",
    "seed:heal-regions": "tsx prisma/seed-heal-regions.ts",
    "mint:session": "tsx scripts/mint-dev-session.ts",
    "perf:matrix": "bash ../performance/run-matrix.sh",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "node dist/workers/worker-main.js",
    "start:worker:dev": "nest start --watch --path tsconfig.worker.json --entryFile workers/worker-main",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "openapi:export": "nest build && node scripts/export-openapi.mjs",
    "test:unit": "env -u DATABASE_URL -u GOOGLE_MAPS_API_KEY -u GOONG_API_KEY -u MAPS_PROVIDER vitest run --exclude \"test/concurrency/**\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.1.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^11.9.0",
    "@simplewebauthn/server": "^14.0.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}

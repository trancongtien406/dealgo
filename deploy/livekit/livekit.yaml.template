# LiveKit server config template. ./render.sh fills the __NAME__-style placeholders from .env into livekit.yaml.
# Do not put keys here: they are read from key_file (keys.yaml, chmod 600, made by gen-keys.sh).
port: 7880
bind_addresses:
  - ""
logging:
  level: info
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  use_external_ip: __USE_EXTERNAL_IP__
  enable_loopback_candidate: false
__NODE_IP_LINE__
turn:
  enabled: true
  domain: __TURN_DOMAIN__
  # Caddy terminates TLS for TURN_DOMAIN on :443 and forwards plain TCP here.
  tls_port: 5349
  external_tls: true
  udp_port: 3478
key_file: /etc/livekit-keys.yaml
room:
  # 1:1 calls (driver <-> customer); a closed room frees its ports quickly.
  empty_timeout: 120
  departure_timeout: 20
__REDIS_BLOCK__

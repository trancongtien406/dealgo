# LiveKit self-host kit: copy to .env on the VPS (same folder) and fill in.
# No secrets here. The API key/secret live in keys.yaml (made by ./gen-keys.sh, chmod 600).

# Public hostnames. Both A records must point at this VPS before Caddy can get certificates.
LIVEKIT_DOMAIN=livekit.example.com
TURN_DOMAIN=turn.example.com

# Email for Let's Encrypt expiry notices.
ACME_EMAIL=ops@example.com

# Pinned images. Upgrade by changing these tags (see docs/09-operations/livekit-self-host.md).
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.11
CADDY_IMAGE=livekit/caddyl4:v2.11.3
REDIS_IMAGE=redis:7.4-alpine

# Optional. Leave empty: LiveKit finds its public IP via STUN (rtc.use_external_ip: true).
# Set only if STUN reports a wrong address (some NAT'd clouds); then use_external_ip is turned off.
LIVEKIT_NODE_IP=

# Optional. Set COMPOSE_PROFILES=redis to also start the local redis and point LiveKit at it.
# Not needed for a single node; needed before adding Egress/Ingress or a second node.
COMPOSE_PROFILES=

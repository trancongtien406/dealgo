
# --- DealGo (compose project "dealgo" in /opt/dealgo; containers join vms_edge) ---
dealgo.laptrinhapp.com {
	import http01_only
	encode gzip zstd
	reverse_proxy dealgo-web:3000
	import common_headers
	log {
		output stdout
		format console
	}
}

api-dealgo.laptrinhapp.com {
	import http01_only
	encode gzip zstd
	request_body {
		max_size 25MB
	}
	# REST + Socket.IO (websocket upgrade is proxied as-is; no read timeout for long-lived sockets).
	reverse_proxy dealgo-api:3001 {
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
	import common_headers
	log {
		output stdout
		format console
	}
}

# LiveKit signalling (wss) -> LiveKit on the host network, reached via the vms_edge gateway.
livekit-dealgo.laptrinhapp.com {
	import http01_only
	reverse_proxy 172.19.0.1:7880 {
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
	log {
		output stdout
		format console
	}
}

# DealGo TURN host (DNS-only). Caddy only obtains/renews the certificate; LiveKit serves TURN/TLS on :5349 with it.
turn-dealgo.laptrinhapp.com {
	import http01_only
	respond "DealGo TURN" 404
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Debug builds only: development APNs. Release/Profile use Runner-Release.entitlements. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(DEALGO_APP_LINK_HOST)</string>
		<string>webcredentials:$(DEALGO_APP_LINK_HOST)</string>
	</array>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
